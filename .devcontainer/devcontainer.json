{
  "name": "Potsure",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/markheydon/devcontainer-features/spec-kit:1": {},
    "ghcr.io/markheydon/devcontainer-features/dev-agent-tools:1": {},
    "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
  },
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "onCreateCommand": "bash .devcontainer/setup-dotnet-dev-cert.sh",
  "remoteEnv": {
    "PATH": "/home/vscode/.aspire/bin:${containerEnv:PATH}",
    "ASPIRE_HOME": "/home/vscode/.aspire",
    "ASPIRE_LAYOUT_PATH": "/home/vscode/.aspire/bundle",
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust",
    "CURSOR_API_KEY": "${localEnv:CURSOR_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "GH_HOST": "github.com"
  },
  "postCreateCommand": "bash .devcontainer/install-aspire-cli.sh",
  "postStartCommand": "aspire certs trust --non-interactive",
  "customizations": {
    "vscode": {
      "extensions": [
        "microsoft-aspire.aspire-vscode",
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}