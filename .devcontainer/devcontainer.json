{
  "name": "Potsure",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/markheydon/devcontainer-features/copilot-likes:1": {},
    "ghcr.io/markheydon/devcontainer-features/spec-kit:1": {},
    "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libnss3-tools",
  "remoteEnv": {
    "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust"
  },
  "postStartCommand": "aspire certs trust --non-interactive",
  "customizations": {
    "vscode": {
      "extensions": [
        "microsoft-aspire.aspire-vscode",
        "ms-dotnettools.csdevkit",
        "GitHub.copilot",
        "GitHub.vscode-github-actions"
      ]
    }
  }
}