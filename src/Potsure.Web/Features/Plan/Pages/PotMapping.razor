@page "/plan/pots"
@rendermode InteractiveServer

<PageTitle>Pot mapping</PageTitle>

<PotsurePageHeader Title="Bank pot mapping"
                   Description="Map each Monzo pot to exactly one budget category, or budget by category only."
                   HeadingLevel="1">
    <Actions>
        <PotsureRelatedNav>
            <BbButton Href="/plan/funding" Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                <Icon><LucideIcon Name="wallet" Size="15" /></Icon>
                <ChildContent>Recorded funding</ChildContent>
            </BbButton>
        </PotsureRelatedNav>
    </Actions>
</PotsurePageHeader>

@if (_loading)
{
    <PotsureLoadingState Message="Loading pot settings…" />
}
else if (_loadError is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
        <ChildContent>
            <BbAlertTitle>Pot mapping unavailable</BbAlertTitle>
            <BbAlertDescription>@_loadError</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}
else
{
    <PotsureSection Title="How do you use Monzo pots?"
                    Description="Choose whether Potsure tracks Monzo pots or only category totals. You can change this at any time."
                    Class="bb:w-full bb:max-w-4xl">
        @if (_modeError is not null)
        {
            <BbAlert Variant="AlertVariant.Warning"
                     AccentBorder="true"
                     AdditionalAttributes="@InlineAlertAttributes">
                <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
                <ChildContent>
                    <BbAlertDescription>@_modeError</BbAlertDescription>
                </ChildContent>
            </BbAlert>
        }
        <div class="bb:grid bb:gap-2 bb:max-w-md">
            <BbLabel For="pot-mode-select">Pot mapping</BbLabel>
            <BbSelect TValue="PotMappingMode" @bind-Value="Mode">
                <BbSelectTrigger Id="pot-mode-select">
                    <BbSelectValue Placeholder="Select how you use pots">
                        <ChildContent Context="ignored">
                            @PotMappingModeDisplay.Format(_mode)
                        </ChildContent>
                    </BbSelectValue>
                </BbSelectTrigger>
                <BbSelectContent>
                    @foreach (PotMappingMode mode in PotMappingModeDisplay.OptionsInDisplayOrder)
                    {
                        <BbSelectItem TValue="PotMappingMode" Value="@mode" Text="@PotMappingModeDisplay.Format(mode)" />
                    }
                </BbSelectContent>
            </BbSelect>
        </div>
    </PotsureSection>

    @if (_mode != PotMappingMode.CategoryOnly)
    {
        <PotsureSection Title="Pots" Class="bb:w-full bb:max-w-4xl">
            @if (_potsError is not null)
            {
                <BbAlert Variant="AlertVariant.Warning"
                         AccentBorder="true"
                         AdditionalAttributes="@InlineAlertAttributes">
                    <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
                    <ChildContent>
                        <BbAlertDescription>@_potsError</BbAlertDescription>
                    </ChildContent>
                </BbAlert>
            }
            @if (ShowSimpleDeleteConfirm)
            {
                <BbAlert Variant="AlertVariant.Warning" AccentBorder="true">
                    <BbAlertDescription>
                        Delete pot <strong>@_confirmDeletePotName</strong>? This cannot be undone.
                    </BbAlertDescription>
                </BbAlert>
                <div class="bb:flex bb:flex-wrap bb:gap-2">
                    <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="ConfirmSimpleDeleteAsync">
                        Delete pot
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CancelDeletePot">
                        Cancel
                    </BbButton>
                </div>
            }
            @if (_pots.Count == 0)
            {
                <BbEmpty Title="No pots yet"
                         Description="Add a pot mapped to exactly one category."
                         Size="EmptySize.Small">
                    <Icon><LucideIcon Name="piggy-bank" /></Icon>
                </BbEmpty>
            }
            else
            {
                <BbDataTable @key="_potsTableKey"
                             TData="BankPotReadModel"
                             Data="@_pots"
                             ShowToolbar="false"
                             ShowPagination="false"
                             AriaLabel="Mapped bank pots">
                    <Columns>
                        <BbDataTableColumn TData="BankPotReadModel" TValue="string"
                                           Header="Name"
                                           Property="@(pot => pot.Name)" />
                        <BbDataTableColumn TData="BankPotReadModel" TValue="string"
                                           Header="Category"
                                           Property="@(pot => BudgetCategoryDisplay.Format(pot.CategoryKind))" />
                        <BbDataTableColumn TData="BankPotReadModel" TValue="decimal"
                                           Header="Recorded funding">
                            <CellTemplate Context="pot">
                                @UkCurrencyDisplay.Format(pot.RecordedFundingAmount)
                            </CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="BankPotReadModel" TValue="string"
                                           Header="Actions">
                            <CellTemplate Context="pot">
                                <div class="bb:flex bb:flex-wrap bb:gap-2">
                                    <BbButton Size="ButtonSize.Small"
                                              Variant="ButtonVariant.Outline"
                                              OnClick="@(() => BeginEditPot(pot))">
                                        Edit
                                    </BbButton>
                                    <BbButton Size="ButtonSize.Small"
                                              Variant="ButtonVariant.Outline"
                                              OnClick="@(() => PromptDeletePot(pot))">
                                        Delete
                                    </BbButton>
                                </div>
                            </CellTemplate>
                        </BbDataTableColumn>
                    </Columns>
                </BbDataTable>
            }
            @if (_showFundingDispositionDialog && _confirmDeletePotId is not null)
            {
                <BbAlert Variant="AlertVariant.Warning" AccentBorder="true" Class="bb:mt-4">
                    <BbAlertTitle>Delete @_confirmDeletePotName?</BbAlertTitle>
                    <BbAlertDescription>
                        This pot has @UkCurrencyDisplay.Format(_confirmDeleteRecordedFunding) recorded funding.
                        Roll it into the parent category funding, or discard it when deleting the pot.
                    </BbAlertDescription>
                </BbAlert>
                <div class="bb:flex bb:flex-wrap bb:gap-2 bb:mt-2">
                    <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                              OnClick="@(() => ConfirmFundingDispositionAsync(BankPotFundingDisposition.RollToCategory))">
                        Roll into category funding
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => ConfirmFundingDispositionAsync(BankPotFundingDisposition.Discard))">
                        Discard funding
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                              OnClick="CancelDeletePot">
                        Cancel
                    </BbButton>
                </div>
            }
        </PotsureSection>

        @if (ShowAddPotSection)
        {
            <PotsureSection Title="Add a pot" Class="bb:w-full bb:max-w-4xl">
                <ChildContent>
                @if (_addPotError is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"
                             AccentBorder="true"
                             AdditionalAttributes="@InlineAlertAttributes">
                        <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
                        <ChildContent>
                            <BbAlertDescription>@_addPotError</BbAlertDescription>
                        </ChildContent>
                    </BbAlert>
                }
                <div class="bb:grid bb:gap-4 bb:sm:grid-cols-2">
                    <div class="bb:grid bb:gap-2">
                        <BbLabel>New pot name</BbLabel>
                        <BbInput @bind-Value="_newPotName" />
                    </div>
                    <div class="bb:grid bb:gap-2">
                        <BbLabel>Category</BbLabel>
                        <BbSelect @key="@NewPotCategorySelectKey"
                                  TValue="Guid"
                                  @bind-Value="_newPotCategoryId">
                            <BbSelectTrigger>
                                <BbSelectValue Placeholder="Select category">
                                    <ChildContent Context="ignored">
                                        @SelectedNewPotCategoryLabel
                                    </ChildContent>
                                </BbSelectValue>
                            </BbSelectTrigger>
                            <BbSelectContent>
                                @foreach (CategoryOption option in CategoriesAvailableForNewPot())
                                {
                                    <BbSelectItem TValue="Guid" Value="@option.Id" Text="@BudgetCategoryDisplay.Format(option.Kind)" />
                                }
                            </BbSelectContent>
                        </BbSelect>
                    </div>
                </div>
                </ChildContent>
                <Footer>
                    <BbButton Variant="ButtonVariant.Default" OnClick="CreatePotAsync">Add pot</BbButton>
                </Footer>
            </PotsureSection>
        }
        else if (_editingPotId is null && _mode == PotMappingMode.ThreePots && _pots.Count >= 3)
        {
            <BbTypographyMuted Class="bb:max-w-4xl">
                You have mapped all three pots allowed in three-pot mode. Delete a pot to add a different one.
            </BbTypographyMuted>
        }

        @if (_editingPotId is Guid editingId && _pots.FirstOrDefault(p => p.Id == editingId) is not null)
        {
            <PotsureSection Title="Edit pot" Class="bb:w-full bb:max-w-4xl">
                @if (_editPotError is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"
                             AccentBorder="true"
                             AdditionalAttributes="@InlineAlertAttributes">
                        <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
                        <ChildContent>
                            <BbAlertDescription>@_editPotError</BbAlertDescription>
                        </ChildContent>
                    </BbAlert>
                }
                <BbInput @bind-Value="_editPotName" Placeholder="Pot name" />
                <BbSelect TValue="Guid" @bind-Value="_editPotCategoryId">
                    <BbSelectTrigger>
                        <BbSelectValue Placeholder="Category">
                            <ChildContent Context="ignored">
                                @(CategoriesAvailableForEdit(editingId).FirstOrDefault(c => c.Id == _editPotCategoryId) is { } cat
                                    ? BudgetCategoryDisplay.Format(cat.Kind)
                                    : "Category")
                            </ChildContent>
                        </BbSelectValue>
                    </BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (CategoryOption option in CategoriesAvailableForEdit(editingId))
                        {
                            <BbSelectItem TValue="Guid" Value="@option.Id" Text="@BudgetCategoryDisplay.Format(option.Kind)" />
                        }
                    </BbSelectContent>
                </BbSelect>
                <div class="bb:flex bb:gap-2 bb:mt-2">
                    <BbButton OnClick="SaveEditPotAsync">Save</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelEditPot">Cancel</BbButton>
                </div>
            </PotsureSection>
        }

    }
    else
    {
        <BbAlert Variant="AlertVariant.Info">
            <Icon><LucideIcon Name="info" Size="18" /></Icon>
            <ChildContent>
                <BbAlertDescription>
                    You are budgeting by category only (no Monzo pot mapping). Change pot mapping above if you use Monzo pots.
                    <BbLink Href="/plan">Plan settings</BbLink>
                </BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }
}
