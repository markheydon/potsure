@page "/recurrence/summary"
@rendermode InteractiveServer

<PageTitle>Recurring summary</PageTitle>

<PotsurePageHeader Title="Confirmed recurring summary" HeadingLevel="1" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading summary…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Summary unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_model is not null)
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>@_statusMessage</BbAlertDescription>
        </BbAlert>
    }

    <PotsureSection Title="Confirmed income">
        @if (_model.ConfirmedIncome.Count == 0)
        {
            <BbTypographyP>No confirmed income patterns yet.</BbTypographyP>
        }
        else
        {
            <BbDataTable TData="ConfirmedIncomeSummaryRow"
                           Data="@_model.ConfirmedIncome"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Income patterns used for display splits only">
                <Columns>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Source"
                                       Property="@(row => row.SourceLabel)" />
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Cadence">
                        <CellTemplate Context="row">
                            @row.Cadence
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="decimal"
                                       Header="Amount">
                        <CellTemplate Context="row">
                            @UkCurrencyDisplay.Format(row.FixedAmount ?? row.EstimateAmount ?? 0m)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Splits (Needs / Wants / Savings)">
                        <CellTemplate Context="row">
                            @row.SplitNeedsPercent% / @row.SplitWantsPercent% / @row.SplitSavingsDebtPercent%
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Actions">
                        <CellTemplate Context="row">
                            <div class="bb:flex bb:flex-wrap bb:gap-2">
                                <BbButton Size="ButtonSize.Small"
                                          Variant="ButtonVariant.Outline"
                                          OnClick="@(() => BeginEditIncome(row))">
                                    Edit
                                </BbButton>
                                <BbLink Href="/recurrence/review">Review</BbLink>
                                <BbButton Size="ButtonSize.Small"
                                          Variant="ButtonVariant.Outline"
                                          OnClick="@(() => DeleteIncomeAsync(row.Id))">
                                    Delete
                                </BbButton>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        }
        @if (_editingIncomeId is not null)
        {
            <PotsureSection Title="Edit confirmed income" Class="bb:mt-4">
                <BbLabel>Source label</BbLabel>
                <BbInput @bind-Value="_incomeEdit.SourceLabel" />
                <BbLabel>Cadence</BbLabel>
                <BbSelect TValue="IncomeCadence" @bind-Value="_incomeEdit.Cadence">
                    <BbSelectTrigger>
                        <BbSelectValue Placeholder="Cadence">
                            <ChildContent Context="ignored">
                                @IncomeCadenceLabel(_incomeEdit.Cadence)
                            </ChildContent>
                        </BbSelectValue>
                    </BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (IncomeCadence cadence in Enum.GetValues<IncomeCadence>())
                        {
                            <BbSelectItem TValue="IncomeCadence" Value="@cadence" Text="@IncomeCadenceLabel(cadence)" />
                        }
                    </BbSelectContent>
                </BbSelect>
                <BbLabel>Amount (£)</BbLabel>
                <BbInput Type="InputType.Number"
                         Value="@FormatDecimal(_incomeEdit.Amount)"
                         ValueChanged="@(v => _incomeEdit.Amount = ParseDecimal(v, _incomeEdit.Amount))" />
                <BbLabel>Needs %</BbLabel>
                <BbInput Type="InputType.Number"
                         Value="@FormatDecimal(_incomeEdit.Needs)"
                         ValueChanged="@(v => _incomeEdit.Needs = ParseDecimal(v, _incomeEdit.Needs))" />
                <BbLabel>Wants %</BbLabel>
                <BbInput Type="InputType.Number"
                         Value="@FormatDecimal(_incomeEdit.Wants)"
                         ValueChanged="@(v => _incomeEdit.Wants = ParseDecimal(v, _incomeEdit.Wants))" />
                <BbLabel>Savings &amp; debt %</BbLabel>
                <BbInput Type="InputType.Number"
                         Value="@FormatDecimal(_incomeEdit.SavingsDebt)"
                         ValueChanged="@(v => _incomeEdit.SavingsDebt = ParseDecimal(v, _incomeEdit.SavingsDebt))" />
                <div class="bb:flex bb:flex-wrap bb:gap-2 bb:mt-2">
                    <BbButton OnClick="SaveIncomeEditAsync">Save changes</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelEdit">Cancel</BbButton>
                </div>
            </PotsureSection>
        }
    </PotsureSection>

    <PotsureSection Title="Confirmed expenses">
        @if (_model.ConfirmedExpenses.Count == 0)
        {
            <BbTypographyP>No confirmed expense patterns yet.</BbTypographyP>
        }
        else
        {
            <BbDataTable TData="ConfirmedExpenseSummaryRow"
                           Data="@_model.ConfirmedExpenses"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Expense commitments for budget balance">
                <Columns>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Vendor"
                                       Property="@(row => row.VendorLabel)" />
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Category">
                        <CellTemplate Context="row">
                            @BudgetCategoryDisplay.Format(row.CategoryKind)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Cadence">
                        <CellTemplate Context="row">
                            @row.Cadence
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="decimal"
                                       Header="Amount">
                        <CellTemplate Context="row">
                            @UkCurrencyDisplay.Format(row.FixedAmount ?? row.StoredMonthlyEstimate ?? 0m)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Coverage"
                                       Property="@(row => row.EstimateCoverageLabel ?? "-")" />
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Tag"
                                       Property="@(row => row.Tag ?? "-")" />
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Actions">
                        <CellTemplate Context="row">
                            <div class="bb:flex bb:flex-wrap bb:gap-2">
                                <BbButton Size="ButtonSize.Small"
                                          Variant="ButtonVariant.Outline"
                                          OnClick="@(() => BeginEditExpenseAsync(row))">
                                    Edit
                                </BbButton>
                                <BbLink Href="/recurrence/review">Review</BbLink>
                                <BbButton Size="ButtonSize.Small"
                                          Variant="ButtonVariant.Outline"
                                          OnClick="@(() => DeleteExpenseAsync(row.Id))">
                                    Delete
                                </BbButton>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        }
        @if (_editingExpenseId is not null)
        {
            <PotsureSection Title="Edit confirmed expense" Class="bb:mt-4">
                <BbLabel>Vendor label</BbLabel>
                <BbInput @bind-Value="_expenseEdit.VendorLabel" />
                <BbLabel>Category</BbLabel>
                <BbSelect TValue="Guid"
                          Value="@_expenseEdit.CategoryId"
                          ValueChanged="SetExpenseCategory">
                    <BbSelectTrigger>
                        <BbSelectValue Placeholder="Category">
                            <ChildContent Context="ignored">
                                @CategoryLabel(_expenseEdit.CategoryId)
                            </ChildContent>
                        </BbSelectValue>
                    </BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (var category in _categories)
                        {
                            <BbSelectItem TValue="Guid" Value="@category.Id" Text="@BudgetCategoryDisplay.Format(category.Kind)" />
                        }
                    </BbSelectContent>
                </BbSelect>
                @if (ShowPotUi)
                {
                    <BbLabel>Mapped pot (optional)</BbLabel>
                    <BbSelect TValue="Guid" @bind-Value="ExpensePotSelection">
                        <BbSelectTrigger>
                            <BbSelectValue Placeholder="None">
                                <ChildContent Context="ignored">
                                    @PotSelectionLabel(ExpensePotSelection)
                                </ChildContent>
                            </BbSelectValue>
                        </BbSelectTrigger>
                        <BbSelectContent>
                            <BbSelectItem TValue="Guid" Value="@Guid.Empty" Text="None" />
                            @foreach (var pot in PotsForCategory(_expenseEdit.CategoryId))
                            {
                                <BbSelectItem TValue="Guid" Value="@pot.Id" Text="@pot.Name" />
                            }
                        </BbSelectContent>
                    </BbSelect>
                }
                <BbLabel>Tag (optional)</BbLabel>
                <BbInput @bind-Value="_expenseEdit.Tag" />
                <BbLabel>Cadence</BbLabel>
                <BbSelect TValue="ExpenseCadence" @bind-Value="_expenseEdit.Cadence">
                    <BbSelectTrigger>
                        <BbSelectValue Placeholder="Cadence">
                            <ChildContent Context="ignored">
                                @_expenseEdit.Cadence
                            </ChildContent>
                        </BbSelectValue>
                    </BbSelectTrigger>
                    <BbSelectContent>
                        @foreach (ExpenseCadence cadence in Enum.GetValues<ExpenseCadence>())
                        {
                            <BbSelectItem TValue="ExpenseCadence" Value="@cadence" Text="@cadence.ToString()" />
                        }
                    </BbSelectContent>
                </BbSelect>
                <BbLabel>Amount behaviour</BbLabel>
                <BbSelect TValue="ExpenseAmountKind" @bind-Value="_expenseEdit.AmountKind">
                    <BbSelectTrigger>
                        <BbSelectValue Placeholder="Fixed or variable">
                            <ChildContent Context="ignored">
                                @ExpenseAmountKindLabel(_expenseEdit.AmountKind)
                            </ChildContent>
                        </BbSelectValue>
                    </BbSelectTrigger>
                    <BbSelectContent>
                        <BbSelectItem TValue="ExpenseAmountKind" Value="@ExpenseAmountKind.Fixed" Text="Fixed per payment" />
                        <BbSelectItem TValue="ExpenseAmountKind" Value="@ExpenseAmountKind.Variable" Text="Variable (monthly estimate)" />
                    </BbSelectContent>
                </BbSelect>
                <BbLabel>Amount (£)</BbLabel>
                <BbInput Type="InputType.Number"
                         Value="@FormatDecimal(_expenseEdit.Amount)"
                         ValueChanged="@(v => _expenseEdit.Amount = ParseDecimal(v, _expenseEdit.Amount))" />
                @if (_expenseEdit.AmountKind == ExpenseAmountKind.Variable)
                {
                    @if (!string.IsNullOrWhiteSpace(_expenseEdit.CoverageLabel))
                    {
                        <BbTypographyMuted Class="bb:text-sm">@_expenseEdit.CoverageLabel</BbTypographyMuted>
                    }
                    @if (_pendingVariableSuggestion is not null)
                    {
                        <BbTypographyMuted Class="bb:text-sm">
                            Suggested from recent spend: £@FormatDecimal(_pendingVariableSuggestion.MonthlyEstimate)
                            (@_pendingVariableSuggestion.CoverageLabel)
                        </BbTypographyMuted>
                        <BbButton Size="ButtonSize.Small"
                                  Variant="ButtonVariant.Outline"
                                  OnClick="AcceptPendingVariableSuggestion">
                            Use suggested estimate
                        </BbButton>
                    }
                }
                @if (_expenseEdit.AmountKind == ExpenseAmountKind.Fixed)
                {
                    <BbLabel>Payment anchor</BbLabel>
                    <BbDatePicker Value="@(_expenseEdit.PaymentAnchor?.ToDateTime(TimeOnly.MinValue))"
                                  ValueChanged="SetExpensePaymentAnchor" />
                }
                <div class="bb:flex bb:flex-wrap bb:gap-2 bb:mt-2">
                    <BbButton OnClick="SaveExpenseEditAsync">Save changes</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="CancelEdit">Cancel</BbButton>
                </div>
            </PotsureSection>
        }
    </PotsureSection>

    <PotsureSection Title="Suggestions (not confirmed)">
        @if (_model.Suggestions.Count == 0)
        {
            <BbTypographyP>No open suggestions.</BbTypographyP>
        }
        else
        {
            <BbItemGroup>
                @foreach (SuggestedPatternSummaryRow row in _model.Suggestions)
                {
                    <BbItem>
                        <BbItemTitle>@row.Label  -  @(row.IsIncome ? "Income" : "Expense"), @row.CadenceDescription, @(row.AmountSummary ?? "Amount unknown")</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
            <BbTypographyP><BbLink Href="/recurrence/review">Review suggestions</BbLink></BbTypographyP>
        }
    </PotsureSection>
}
