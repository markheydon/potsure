@page "/reports/category-health"
@rendermode InteractiveServer

<PageTitle>Category health</PageTitle>

<PotsurePageHeader Title="Category health" HeadingLevel="1" Class="mb-4" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading report…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Report unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_summary is not null)
{
    <section class="space-y-4" aria-label="Income">
        <PotsurePageHeader Title="Income" HeadingLevel="2" Class="mb-4" />
        <BbItemGroup Class="grid gap-2 sm:grid-cols-2">
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>@ReportCopy.BudgetedIncomeHeading</BbItemTitle>
                    <BbItemDescription>£@_summary.Value.BudgetedIncome.Amount.ToString("F2")</BbItemDescription>
                </BbItemContent>
            </BbItem>
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>@ReportCopy.ActualReceiptsHeading</BbItemTitle>
                    <BbItemDescription>£@_summary.Value.ActualIncomeInPeriod.Amount.ToString("F2")</BbItemDescription>
                </BbItemContent>
            </BbItem>
        </BbItemGroup>
        <BbTypographyMuted>@ReportCopy.CategoryHealthBudgetedNote</BbTypographyMuted>
    </section>

    @if (_categoryChartRows.Count > 0)
    {
        <section aria-label="Category measures chart">
            <PotsurePageHeader Title="Category measures chart"
                               HeadingLevel="2"
                               Class="sr-only mb-4" />
            <BbBarChart Data="@_categoryChartRows"
                        Config="@_categoryChartConfig"
                        Title="Category measures"
                        Height="350px"
                        AriaLabel="Grouped bar chart of allocation, recorded funding and actual activity by category">
                <BbXAxis DataKey="Category" />
                <BbYAxis />
                <BbChartTooltip />
                <BbChartLegend />
                <BbBar DataKey="Allocation" />
                <BbBar DataKey="RecordedFunding" />
                <BbBar DataKey="Actual" />
            </BbBarChart>
        </section>
    }

    <BbDataTable TData="CategoryPeriodTableRow"
                 Data="@_categoryTableRows"
                 ShowToolbar="false"
                 ShowPagination="false"
                 AriaLabel="@CategoryTableAriaLabel">
        <Columns>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="BudgetCategoryKind"
                               Header="Category">
                <CellTemplate Context="row">
                    @FormatKind(row.Summary.Kind)
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Allocation">
                <CellTemplate Context="row">
                    £@row.Summary.Allocation.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Recorded funding">
                <CellTemplate Context="row">
                    £@row.Summary.RecordedFunding.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Actual activity">
                <CellTemplate Context="row">
                    £@row.Summary.ActualActivity.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Under / over">
                <CellTemplate Context="row">
                    £@row.Summary.UnderOver.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    @foreach (CategoryPeriodSummary row in _summary.Value.Categories.Where(c => c.OverAllocationWarning))
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Over-allocation</BbAlertTitle>
            <BbAlertDescription>
                Recorded funding and pot assignments exceed allocation for @FormatKind(row.Kind).
            </BbAlertDescription>
        </BbAlert>
    }

    @if (_potBreakdown.Count > 0)
    {
        <section aria-label="Mapped bank pots">
            <PotsurePageHeader Title="Mapped bank pots" HeadingLevel="2" Class="mb-4" />
            <BbDataTable TData="CategoryPotBreakdownLine"
                           Data="@_potBreakdown"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Pot funding by category">
                <Columns>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="BudgetCategoryKind"
                                       Header="Category">
                        <CellTemplate Context="pot">
                            @FormatKind(pot.Category)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="string"
                                       Header="Pot"
                                       Property="@(pot => pot.PotName)" />
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="string"
                                       Header="Allocation to pot">
                        <CellTemplate Context="pot">
                            @(pot.AllocationToPot is decimal allocation ? $"£{allocation:F2}" : "-")
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="decimal"
                                       Header="Recorded funding">
                        <CellTemplate Context="pot">
                            £@pot.RecordedFunding.ToString("F2")
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        </section>
    }

    <div class="mt-4" id="category-health-text-summary">
        <BbTypographyMuted>Textual summary:</BbTypographyMuted>
        <BbItemGroup>
            @foreach (CategoryPeriodSummary row in _summary.Value.Categories)
            {
                <BbItem>
                    <BbItemTitle>@FormatKind(row.Kind): allocation £@row.Allocation.Amount.ToString("F2"), recorded funding £@row.RecordedFunding.Amount.ToString("F2"), actual £@row.ActualActivity.Amount.ToString("F2"), under/over £@row.UnderOver.Amount.ToString("F2").</BbItemTitle>
                </BbItem>
            }
        </BbItemGroup>
    </div>

    @if (_summary.Value.UncategorisedSpendWarning)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Uncategorised spend</BbAlertTitle>
            <BbAlertDescription>
                £@_summary.Value.UncategorisedSpend.Amount.ToString("F2") of spend is not attributed to a category.
                <BbLink Href="/reports/categorise">Assign transactions</BbLink>
                ·
                <BbLink Href="/reports/attribution">Reassign attributed debits</BbLink>
            </BbAlertDescription>
        </BbAlert>
    }
}
