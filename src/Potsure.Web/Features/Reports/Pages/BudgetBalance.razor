@page "/reports/budget-balance"
@rendermode InteractiveServer

<PageTitle>Budget balance</PageTitle>

<PotsurePageHeader Title="Budget balance" HeadingLevel="1" Class="bb:mb-4" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading report…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Report unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_report is not null)
{
    <BbTypographyMuted AdditionalAttributes="@(new Dictionary<string, object> { ["role"] = "note" })">@ReportCopy.ForecastDisclaimer</BbTypographyMuted>

    <section aria-labelledby="balance-income-chart">
        <PotsurePageHeader Title="Planned income versus required total"
                           HeadingLevel="2"
                           Class="bb:sr-only bb:mb-4" />
        <BbBarChart Data="@_budgetCompareRows"
                    Title="Planned income vs required total"
                    Height="300px"
                    AriaLabel="Bar chart comparing planned income and required total">
            <BbXAxis DataKey="Label" />
            <BbYAxis />
            <BbChartTooltip />
            <BbBar DataKey="Amount" FillKey="Fill" BorderRadius="6" />
        </BbBarChart>
    </section>

    <section aria-labelledby="balance-income">
        <PotsurePageHeader Title="Income (separate measures)" HeadingLevel="2" Class="bb:mb-4" />
        <BbItemGroup Class="bb:grid bb:gap-2 bb:sm:grid-cols-2">
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>@ReportCopy.BudgetedIncomeHeading</BbItemTitle>
                    <BbItemDescription>£@_report.Value.BudgetedIncome.Amount.ToString("F2")</BbItemDescription>
                </BbItemContent>
            </BbItem>
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>@ReportCopy.ActualReceiptsHeading</BbItemTitle>
                    <BbItemDescription>£@_report.Value.ActualReceiptsInPeriod.Amount.ToString("F2")</BbItemDescription>
                </BbItemContent>
            </BbItem>
        </BbItemGroup>
    </section>

    <section aria-labelledby="balance-commitments">
        <PotsurePageHeader Title="@ReportCopy.CommitmentsHeading" HeadingLevel="2" Class="bb:mb-4" />
        <BbItemGroup>
            @foreach (CategoryCommitmentInput commitment in _report.Value.PeriodCommitments)
            {
                <BbItem>
                    <BbItemTitle>@FormatKind(commitment.Category): £@commitment.AmountInPeriod.Amount.ToString("F2")</BbItemTitle>
                </BbItem>
            }
        </BbItemGroup>
    </section>

    <section aria-labelledby="balance-required">
        <PotsurePageHeader Title="Required income" HeadingLevel="2" Class="bb:mb-4" />
        <BbTypographyP>
            Overall required:
            £@_report.Value.RequiredIncome.RequiredTotal.Amount.ToString("F2")
            (limiting category: @FormatKind(_report.Value.RequiredIncome.LimitingCategory))
        </BbTypographyP>
        @if (_potBreakdown.Count > 0)
        {
            <BbCollapsible>
                <BbCollapsibleTrigger>
                    <BbButton Variant="ButtonVariant.Outline">
                        Mapped pots for @FormatKind(_report.Value.RequiredIncome.LimitingCategory)
                    </BbButton>
                </BbCollapsibleTrigger>
                <BbCollapsibleContent Class="bb:pt-2">
                    <BbItemGroup>
                        @foreach (CategoryPotBreakdownLine pot in _potBreakdown.Where(p => p.Category == _report.Value.RequiredIncome.LimitingCategory))
                        {
                            <BbItem>
                                <BbItemTitle>@pot.PotName  -  recorded funding £@pot.RecordedFunding.ToString("F2")</BbItemTitle>
                            </BbItem>
                        }
                    </BbItemGroup>
                </BbCollapsibleContent>
            </BbCollapsible>
        }
        @if (_report.Value.RequiredIncome.Shortfall.Amount > 0m)
        {
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertTitle>Shortfall</BbAlertTitle>
                <BbAlertDescription>
                    Planned income is £@_report.Value.RequiredIncome.Shortfall.Amount.ToString("F2") below the required amount.
                    Balance conclusion: No.
                </BbAlertDescription>
            </BbAlert>
        }
        else
        {
            <BbAlert Variant="AlertVariant.Default">
                <BbAlertTitle>Balance conclusion</BbAlertTitle>
                <BbAlertDescription>Yes  -  planned income meets required income for this period.</BbAlertDescription>
            </BbAlert>
        }
    </section>

    @if (_variableExpenses.Count > 0)
    {
        <section aria-labelledby="balance-variable">
            <PotsurePageHeader Title="Variable expense coverage" HeadingLevel="2" Class="bb:mb-4" />
            <BbItemGroup>
                @foreach (ConfirmedExpenseSummaryRow expense in _variableExpenses)
                {
                    <BbItem>
                        <BbItemTitle>@expense.VendorLabel: @(expense.EstimateCoverageLabel ?? "Estimate pending")</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        </section>
    }

    <BbTypographyMuted Class="bb:mt-4"
                       AdditionalAttributes="@(new Dictionary<string, object> { ["id"] = "balance-text-summary" })">
        Textual summary: planned income £@_report.Value.BudgetedIncome.Amount.ToString("F2");
        actual receipts £@_report.Value.ActualReceiptsInPeriod.Amount.ToString("F2");
        required total £@_report.Value.RequiredIncome.RequiredTotal.Amount.ToString("F2").
    </BbTypographyMuted>

    @if (_report.Value.ExpectedIncomePayments.Count > 0)
    {
        <section aria-labelledby="balance-expected-income">
            <PotsurePageHeader Title="@ReportCopy.ExpectedIncomeHeading" HeadingLevel="2" Class="bb:mb-4" />
            <BbItemGroup>
                @foreach (ExpectedIncomePayment payment in _report.Value.ExpectedIncomePayments)
                {
                    <BbItem>
                        <BbItemTitle>@payment.ExpectedDate: £@payment.Amount.Amount.ToString("F2")</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        </section>
    }
}
