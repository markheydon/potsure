@page "/import"
@rendermode InteractiveServer

<PageTitle>Import statement</PageTitle>

<PotsurePageHeader Title="Import Monzo statement"
                   Description="Upload a CSV export from Monzo to bring your transactions into Potsure."
                   HeadingLevel="1"
                   AdditionalAttributes="@(new Dictionary<string, object> { ["tabindex"] = "-1", ["id"] = "import-heading" })" />

@if (_isBusy)
{
    <BbAlert Variant="AlertVariant.Info">
        <Icon><BbSpinner AriaLabel="Importing" /></Icon>
        <ChildContent>
            <BbAlertTitle>Importing</BbAlertTitle>
            <BbAlertDescription>Processing your CSV file…</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}
else if (_summary is not null && !_awaitingAccountConfirmation)
{
    <ImportSummaryView Summary="_summary" FileName="_selectedFileName" OnImportAnother="ResetWizard" />
}
else
{
    @if (_awaitingAccountConfirmation)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <Icon><LucideIcon Name="triangle-alert" Size="18" /></Icon>
            <ChildContent>
                <BbAlertTitle>Confirm account</BbAlertTitle>
                <BbAlertDescription>
                    Monzo CSV exports do not include an account identifier, so we cannot match this file automatically on your first upload.
                    Tick the box below to confirm this export is yours; we remember that link for future imports.
                    There is no separate Monzo account settings page.
                </BbAlertDescription>
            </ChildContent>
        </BbAlert>
    }

    @if (_awaitingMappingConfirmation && _preview is not null)
    {
        <PotsureSection Title="Confirm column mapping"
                        AdditionalAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Confirm column mapping" })">
            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                <BbBadge Variant="BadgeVariant.SoftSuccess">@_preview.ParsedRowCount row(s) ready</BbBadge>
                @if (_preview.ParseErrorCount > 0)
                {
                    <BbBadge Variant="BadgeVariant.SoftWarning">@_preview.ParseErrorCount row(s) skipped</BbBadge>
                }
            </div>
            <BbTypographyMuted>
                We detected a Monzo export with @_preview.ParsedRowCount row(s) ready to import
                (@_preview.ParseErrorCount row(s) skipped due to validation errors).
            </BbTypographyMuted>
            <BbDataTable TData="string"
                           Data="@MappingRequiredHeaders"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Required columns">
                <Columns>
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="Column"
                                       Property="@(header => header)" />
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="File header">
                        <CellTemplate Context="header">
                            <BbSelect TValue="string" @bind-Value="_columnMapping[header]">
                                <BbSelectTrigger>
                                    <BbSelectValue Placeholder="Select header" />
                                </BbSelectTrigger>
                                <BbSelectContent>
                                    @foreach (string fileHeader in _preview.ColumnMapping.FileHeaders)
                                    {
                                        <BbSelectItem TValue="string" Value="@fileHeader" Text="@fileHeader" />
                                    }
                                </BbSelectContent>
                            </BbSelect>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="Status"
                                       Property="@(header => _preview.ColumnMapping.MissingRequiredHeaders.Contains(header) ? "Missing" : "Detected")" />
                </Columns>
            </BbDataTable>
            @if (_preview.PreviewErrors.Count > 0)
            {
                <BbCollapsible>
                    <BbCollapsibleTrigger>
                        <BbButton Variant="ButtonVariant.Outline">
                            Preview validation messages (@_preview.PreviewErrors.Count)
                        </BbButton>
                    </BbCollapsibleTrigger>
                    <BbCollapsibleContent Class="bb:pt-2">
                        <BbItemGroup>
                            @foreach (string message in _preview.PreviewErrors.Take(20))
                            {
                                <BbItem>
                                    <BbItemTitle>@message</BbItemTitle>
                                </BbItem>
                            }
                        </BbItemGroup>
                    </BbCollapsibleContent>
                </BbCollapsible>
            }
        </PotsureSection>
    }

    <section class="bb:space-y-4" aria-labelledby="import-heading">
        <BbCard Class="bb:w-full bb:max-w-4xl">
            <BbCardHeader>
                <BbCardTitle>Upload CSV</BbCardTitle>
                <BbCardDescription>
                    Select a Monzo statement export (.csv). Rows that cannot be imported are listed in the summary.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="bb:space-y-4">
                <BbFileUpload Accept=".csv,text/csv"
                              MaxFileSize="10485760"
                              Multiple="false"
                              ShowPreview="false"
                              AutoUpload="false"
                              Disabled="@_isBusy"
                              Files="@_uploadFiles"
                              FilesChanged="OnUploadFilesChangedAsync" />
                @if (!string.IsNullOrEmpty(_selectedFileName))
                {
                    <BbTypographyP>Selected: @_selectedFileName</BbTypographyP>
                }
            </BbCardContent>
            <BbCardFooter Class="bb:justify-end bb:gap-2">
                @if (_awaitingAccountConfirmation)
                {
                    <div class="bb:flex bb:items-center bb:gap-2">
                        <BbCheckbox @bind-Checked="_accountConfirmed" Id="confirm-account" />
                        <BbLabel For="confirm-account" Class="bb:font-normal">I confirm this export is from my Monzo account</BbLabel>
                    </div>
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(!_accountConfirmed || _pendingFile is null)"
                              OnClick="ConfirmAccountAndImportAsync">
                        Confirm and import
                    </BbButton>
                }
                else if (_awaitingMappingConfirmation)
                {
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(_pendingFile is null)"
                              OnClick="ConfirmMappingAsync">
                        Confirm mapping and import
                    </BbButton>
                }
                else
                {
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(_pendingFile is null)"
                              OnClick="ImportWithoutConfirmationAsync">
                        Import
                    </BbButton>
                }
            </BbCardFooter>
        </BbCard>
    </section>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <BbAlert Variant="AlertVariant.Danger">
        <Icon><LucideIcon Name="circle-alert" Size="18" /></Icon>
        <ChildContent>
            <BbAlertTitle>Import failed</BbAlertTitle>
            <BbAlertDescription>@_errorMessage</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}
