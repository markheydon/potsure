@page "/import"
@rendermode InteractiveServer

<PageTitle>Import statement</PageTitle>

<PotsurePageHeader Title="Import Monzo statement"
                   HeadingLevel="1"
                   Class="bb:mb-4"
                   AdditionalAttributes="@(new Dictionary<string, object> { ["tabindex"] = "-1", ["id"] = "import-heading" })" />

@if (_isBusy)
{
    <BbAlert Variant="AlertVariant.Default">
        <BbAlertTitle>Importing</BbAlertTitle>
        <BbAlertDescription>Processing your CSV file…</BbAlertDescription>
    </BbAlert>
}
else if (_summary is not null && !_awaitingAccountConfirmation)
{
    <ImportSummaryView Summary="_summary" OnImportAnother="ResetWizard" />
}
else
{
    @if (_awaitingAccountConfirmation)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Confirm account</BbAlertTitle>
            <BbAlertDescription>
                We could not verify this export against your linked Monzo account. Confirm it is yours before importing.
            </BbAlertDescription>
        </BbAlert>
    }

    @if (_awaitingMappingConfirmation && _preview is not null)
    {
        <section class="bb:space-y-4" aria-label="Confirm column mapping">
            <PotsurePageHeader Title="Confirm column mapping" HeadingLevel="2" Class="bb:mb-4" />
            <BbTypographyMuted>
                We detected a Monzo export with @_preview.ParsedRowCount row(s) ready to import
                (@_preview.ParseErrorCount row(s) skipped due to validation errors).
            </BbTypographyMuted>
            <BbDataTable TData="string"
                           Data="@MappingRequiredHeaders"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Required columns">
                <Columns>
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="Column"
                                       Property="@(header => header)" />
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="File header">
                        <CellTemplate Context="header">
                            <BbSelect TValue="string" @bind-Value="_columnMapping[header]">
                                <BbSelectTrigger>
                                    <BbSelectValue Placeholder="Select header" />
                                </BbSelectTrigger>
                                <BbSelectContent>
                                    @foreach (string fileHeader in _preview.ColumnMapping.FileHeaders)
                                    {
                                        <BbSelectItem TValue="string" Value="@fileHeader" Text="@fileHeader" />
                                    }
                                </BbSelectContent>
                            </BbSelect>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="string" TValue="string"
                                       Header="Status"
                                       Property="@(header => _preview.ColumnMapping.MissingRequiredHeaders.Contains(header) ? "Missing" : "Detected")" />
                </Columns>
            </BbDataTable>
            @if (_preview.PreviewErrors.Count > 0)
            {
                <BbCollapsible>
                    <BbCollapsibleTrigger>
                        <BbButton Variant="ButtonVariant.Outline">
                            Preview validation messages (@_preview.PreviewErrors.Count)
                        </BbButton>
                    </BbCollapsibleTrigger>
                    <BbCollapsibleContent Class="bb:pt-2">
                        <BbItemGroup>
                            @foreach (string message in _preview.PreviewErrors.Take(20))
                            {
                                <BbItem>
                                    <BbItemTitle>@message</BbItemTitle>
                                </BbItem>
                            }
                        </BbItemGroup>
                    </BbCollapsibleContent>
                </BbCollapsible>
            }
        </section>
    }

    <section class="bb:space-y-4" aria-labelledby="import-heading">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Upload CSV</BbCardTitle>
                <BbCardDescription>
                    Select a Monzo statement export (.csv). Rows that cannot be imported are listed in the summary.
                </BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbFileUpload Accept=".csv,text/csv"
                              MaxFileSize="10485760"
                              Multiple="false"
                              ShowPreview="false"
                              AutoUpload="false"
                              Disabled="@_isBusy"
                              Files="@_uploadFiles"
                              FilesChanged="OnUploadFilesChangedAsync" />
                @if (!string.IsNullOrEmpty(_selectedFileName))
                {
                    <BbTypographyP>Selected: @_selectedFileName</BbTypographyP>
                }
            </BbCardContent>
            <BbCardFooter>
                @if (_awaitingAccountConfirmation)
                {
                    <BbCheckbox @bind-Checked="_accountConfirmed">
                        I confirm this export is from my Monzo account
                    </BbCheckbox>
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(!_accountConfirmed || _pendingFile is null)"
                              OnClick="ConfirmAccountAndImportAsync">
                        Confirm and import
                    </BbButton>
                }
                else if (_awaitingMappingConfirmation)
                {
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(_pendingFile is null)"
                              OnClick="ConfirmMappingAsync">
                        Confirm mapping and import
                    </BbButton>
                }
                else
                {
                    <BbButton Variant="ButtonVariant.Default"
                              Disabled="@(_pendingFile is null)"
                              OnClick="ImportWithoutConfirmationAsync">
                        Import
                    </BbButton>
                }
            </BbCardFooter>
        </BbCard>
    </section>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>Import failed</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
