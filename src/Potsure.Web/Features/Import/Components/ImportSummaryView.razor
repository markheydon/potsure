@using Potsure.Infrastructure.Features.Import

<div class="bb:flex bb:flex-col bb:gap-6">
    <div class="bb:grid bb:gap-4 bb:sm:grid-cols-2 bb:lg:grid-cols-4">
        <PotsureStatTile Label="Imported" Value="@Summary.ImportedCount.ToString()" Icon="circle-check" />
        <PotsureStatTile Label="Skipped" Value="@Summary.SkippedCount.ToString()" Icon="skip-forward" />
        <PotsureStatTile Label="Duplicates" Value="@Summary.DedupedCount.ToString()" Icon="copy" />
        <PotsureStatTile Label="Transfers excluded" Value="@Summary.TransferExcludedCount.ToString()" Icon="arrow-left-right" />
    </div>

    @if (Summary.SkippedReasons.Count > 0)
    {
        <PotsureSection Title="Skipped rows" Description="These rows could not be added.">
            <BbItemGroup>
                @foreach (string reason in Summary.SkippedReasons)
                {
                    <BbItem>
                        <BbItemTitle>@reason</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        </PotsureSection>
    }

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>Import summary</BbCardTitle>
            <BbCardDescription>Upload @Summary.UploadId</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <BbAlert Variant="AlertVariant.Info">
                <Icon><LucideIcon Name="lightbulb" Size="18" /></Icon>
                <ChildContent>
                    <BbAlertDescription>
                        Tip: importing about three months of Monzo history helps Potsure suggest recurring income and expenses more reliably. Shorter history is fine for getting started.
                    </BbAlertDescription>
                </ChildContent>
            </BbAlert>
        </BbCardContent>
        <BbCardFooter Class="bb:justify-end">
            <BbButton Variant="ButtonVariant.Outline" OnClick="OnImportAnother">
                Import another file
            </BbButton>
        </BbCardFooter>
    </BbCard>
</div>

@code {
    [Parameter, EditorRequired]
    public StatementImportSummary Summary { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnImportAnother { get; set; }
}
