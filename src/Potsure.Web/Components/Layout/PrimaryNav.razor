@rendermode InteractiveServer

<BbResponsiveNavProvider>
    <div class="bb:flex bb:flex-1 bb:items-center bb:gap-2 bb:min-w-0">
        <BbResponsiveNavTrigger aria-label="Open navigation menu" />
        <BbResponsiveNavItems Items="_navItems"
                              DesktopClass="bb:flex-1"
                              MobileHeader="@MobileHeader" />
    </div>
</BbResponsiveNavProvider>

@code {
    private static readonly IReadOnlyList<NavItemDefinition> _navItems =
    [
        new() { Text = "Import", Href = "/import" },
        new() { Text = "Plan", Href = "/plan" },
        new() { Text = "Pots", Href = "/plan/pots" },
        new() { Text = "Funding", Href = "/plan/funding" },
        new() { Text = "Recurring", Href = "/recurrence/review" },
        new() { Text = "Category health", Href = "/reports/category-health" },
        new() { Text = "Budget balance", Href = "/reports/budget-balance" },
        new() { Text = "Runway", Href = "/reports/runway" },
        new() { Text = "Export and delete", Href = "/privacy" },
    ];

    private static RenderFragment MobileHeader => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "bb:font-semibold");
        builder.AddContent(2, "Navigation");
        builder.CloseElement();
    };
}
