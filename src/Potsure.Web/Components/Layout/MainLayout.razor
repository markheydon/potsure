@inherits LayoutComponentBase

<div class="relative min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
        <div class="container flex h-14 items-center gap-2 flex-wrap">
            <BbLink Href="/" Class="flex items-center space-x-2 shrink-0 no-underline">
                <LucideIcon Name="piggy-bank" Size="24" Class="text-primary" />
                <BbTypographySmall Class="font-bold">Potsure</BbTypographySmall>
            </BbLink>

            <PrimaryNav />

            <div class="flex shrink-0 items-center justify-end gap-1">
                <BbDarkModeToggle Variant="ButtonVariant.Ghost" />
            </div>
        </div>
    </header>

    <main class="flex-1 container py-6">
        @Body
    </main>

    <footer class="border-t py-4">
        <div class="container">
            <BbTypographyMuted>Potsure — budgeting from your Monzo exports</BbTypographyMuted>
        </div>
    </footer>
</div>

<BbToastProvider Position="ToastPosition.BottomRight" />
<BbDialogProvider />
<BbPortalHost />
