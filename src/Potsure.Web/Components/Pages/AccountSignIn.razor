@page "/account/sign-in"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        string normalized = HostedReturnUrlValidator.Normalize(ReturnUrl) ?? "/";
        string target = Navigation.GetUriWithQueryParameters(
            Navigation.ToAbsoluteUri("/Account/Login").AbsolutePath,
            new Dictionary<string, object?> { ["ReturnUrl"] = normalized });
        Navigation.NavigateTo(target, replace: true);
    }
}
