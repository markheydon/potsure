@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>Page not found</PageTitle>

<div class="flex flex-col items-center justify-center gap-4 px-4 py-16 text-center min-h-[50vh]">
    <BbTypographyMuted Class="text-sm font-medium">404</BbTypographyMuted>
    <BbTypographyH1 Class="text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</BbTypographyH1>
    <BbTypographyMuted Class="max-w-md">
        Sorry, the content you are looking for does not exist.
    </BbTypographyMuted>
    <BbButton Href="/">Return home</BbButton>
</div>
