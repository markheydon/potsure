@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>Page not found</PageTitle>

<div class="bb:flex bb:flex-col bb:items-center bb:justify-center bb:gap-4 bb:px-4 bb:py-8 bb:text-center">
    <BbTypographyMuted Class="bb:text-sm bb:font-medium">404</BbTypographyMuted>
    <BbTypographyH1 Class="bb:text-3xl bb:font-semibold bb:tracking-tight bb:sm:text-4xl">Page not found</BbTypographyH1>
    <BbTypographyMuted Class="bb:max-w-md">
        Sorry, the content you are looking for does not exist.
    </BbTypographyMuted>
    <BbButton Href="/">Return home</BbButton>
</div>
