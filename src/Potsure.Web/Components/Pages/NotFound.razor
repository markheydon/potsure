@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout
@rendermode InteractiveServer

<PageTitle>Page not found</PageTitle>

<div class="flex flex-col items-center justify-center gap-4 px-4 py-16 text-center min-h-[50vh]">
    <p class="text-sm font-medium text-muted-foreground">404</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="max-w-md text-muted-foreground">
        Sorry, the content you are looking for does not exist.
    </p>
    <BbButton Href="/">Return home</BbButton>
</div>
