@page "/"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using Potsure.Web.Configuration
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home</PageTitle>

@if (_isHosted)
{
    <PotsureLoadingState Message="Redirecting to sign in…" />
}
else
{
    <PotsurePageHeader Title="Potsure"
                       Description="Budgeting and statement import for your Monzo exports."
                       HeadingLevel="1"
                       Class="bb:mb-4" />
    <BbTypographyMuted>Use the navigation links to import statements, plan pots, and view reports.</BbTypographyMuted>
}

@code {
    private bool _isHosted;

    protected override async Task OnInitializedAsync()
    {
        DeploymentModeOptions deployment = Configuration
            .GetSection(DeploymentModeOptions.SectionName)
            .Get<DeploymentModeOptions>() ?? new DeploymentModeOptions();
        _isHosted = deployment.Mode == DeploymentMode.Hosted;

        if (!_isHosted)
        {
            return;
        }

        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/reports/category-health", replace: true);
            return;
        }

        Navigation.NavigateTo("/Account/Login", replace: true);
    }
}
