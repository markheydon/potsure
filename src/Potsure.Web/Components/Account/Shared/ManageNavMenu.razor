@using Microsoft.AspNetCore.Identity
@using Potsure.Data.Identity

@inject SignInManager<ApplicationUser> SignInManager

<nav aria-label="Manage account">
    <ul class="potsure-manage-nav">
        <li>
            <NavLink href="Account/Manage" Match="NavLinkMatch.All" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Profile</BbButton>
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Email" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Email</BbButton>
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/ChangePassword" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Password</BbButton>
            </NavLink>
        </li>
        @if (hasExternalLogins)
        {
            <li>
                <NavLink href="Account/Manage/ExternalLogins" ActiveClass="active">
                    <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">External logins</BbButton>
                </NavLink>
            </li>
        }
        <li>
            <NavLink href="Account/Manage/TwoFactorAuthentication" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Two-factor authentication</BbButton>
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/Passkeys" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Passkeys</BbButton>
            </NavLink>
        </li>
        <li>
            <NavLink href="Account/Manage/PersonalData" ActiveClass="active">
                <BbButton Variant="ButtonVariant.Ghost" Type="ButtonType.Button" Class="w-full justify-start">Personal data</BbButton>
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
