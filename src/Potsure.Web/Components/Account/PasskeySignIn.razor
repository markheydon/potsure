@using Potsure.Web.Configuration
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Components
@using Potsure.Web.Services
@using Potsure.Web
@rendermode InteractiveServer
@inject IConfiguration Configuration
@inject PasskeySignInJsInterop PasskeySignInJs
@inject IAntiforgery Antiforgery
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

<BbCard>
    <BbCardHeader>
        <BbCardTitle>Sign in with passkey</BbCardTitle>
        <BbCardDescription>
            Hosted Potsure requires a passkey. Password sign-in is not available in v1 (FR-M025).
        </BbCardDescription>
    </BbCardHeader>
    <BbCardContent>
        @if (_isHosted)
        {
            <p>
                Use your device passkey, security key, or synced passkey to continue. Your financial data stays
                isolated to your account.
            </p>

            @if (_passkeyUnavailable)
            {
                <BbAlert Variant="AlertVariant.Warning">
                    <BbAlertTitle>Passkey not available on this device</BbAlertTitle>
                    <BbAlertDescription>
                        Register or use a passkey on a supported device (for example a phone or laptop with
                        biometrics or a security key), then return here. Non-passkey login is not offered on
                        hosted v1.
                    </BbAlertDescription>
                </BbAlert>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SignInAsync">
                    <div class="potsure-form-field">
                        <BbLabel For="passkey-email">Email (optional for sign-in)</BbLabel>
                        <BbInput Id="passkey-email" @bind-Value="_form.Email" autocomplete="username webauthn" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <BbAlert Variant="@(_messageIsError ? AlertVariant.Warning : AlertVariant.Default)">
                            <BbAlertDescription>@_message</BbAlertDescription>
                        </BbAlert>
                    }

                    <div class="potsure-passkey-actions">
                        <BbButton Type="ButtonType.Submit" Disabled="_busy">Sign in with passkey</BbButton>
                        <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Disabled="_busy" OnClick="RegisterAsync">
                            Register a new passkey
                        </BbButton>
                    </div>
                </EditForm>
            }
        }
        else
        {
            <p>Local-only mode does not require passkey sign-in.</p>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter]
    public bool PasskeyUnavailable { get; set; }

    [Parameter]
    public string? ReturnUrl { get; set; }

    private bool _isHosted;
    private bool _passkeyUnavailable;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private bool _passkeyAvailabilityChecked;
    private readonly PasskeySignInForm _form = new();

    protected override void OnParametersSet()
    {
        DeploymentModeOptions deployment = Configuration
            .GetSection(DeploymentModeOptions.SectionName)
            .Get<DeploymentModeOptions>() ?? new DeploymentModeOptions();
        _isHosted = deployment.Mode == DeploymentMode.Hosted;
        _passkeyUnavailable = PasskeyUnavailable;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_isHosted || _passkeyUnavailable || _passkeyAvailabilityChecked)
        {
            return;
        }

        _passkeyAvailabilityChecked = true;
        _passkeyUnavailable = !await PasskeySignInJs.IsAvailableAsync();
        StateHasChanged();
    }

    private async Task SignInAsync()
    {
        await RunPasskeyFlowAsync(
            () => PasskeySignInJs.SignInAsync(
                string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
                GetAntiforgeryToken()));
    }

    private async Task RegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Email))
        {
            _messageIsError = true;
            _message = "Enter your email before registering a passkey.";
            return;
        }

        await RunPasskeyFlowAsync(
            () => PasskeySignInJs.RegisterAsync(_form.Email.Trim(), GetAntiforgeryToken()));
    }

    private async Task RunPasskeyFlowAsync(Func<Task<(bool Ok, string? Message)>> action)
    {
        _busy = true;
        _message = null;
        try
        {
            (bool ok, string? message) = await action();
            if (ok)
            {
                string destination = HostedReturnUrlValidator.Normalize(ReturnUrl);
                Navigation.NavigateTo(destination, forceLoad: true);
                return;
            }

            _messageIsError = true;
            _message = message ?? "Passkey operation failed.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string GetAntiforgeryToken()
    {
        HttpContext? httpContext = HttpContextAccessor.HttpContext
            ?? throw new InvalidOperationException("HTTP context is required for passkey sign-in.");
        AntiforgeryTokenSet tokens = Antiforgery.GetAndStoreTokens(httpContext);
        return tokens.RequestToken ?? string.Empty;
    }

    private sealed class PasskeySignInForm
    {
        public string Email { get; set; } = string.Empty;
    }
}
