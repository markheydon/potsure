@page "/Account/Lockout"

<PageTitle>Locked out</PageTitle>

<BbCard Class="potsure-auth-narrow">
    <BbCardHeader>
        <BbCardTitle>Locked out</BbCardTitle>
    </BbCardHeader>
    <BbCardContent>
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertDescription>This account has been locked out, please try again later.</BbAlertDescription>
        </BbAlert>
    </BbCardContent>
</BbCard>
