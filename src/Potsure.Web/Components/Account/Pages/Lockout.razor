@page "/Account/Lockout"
@attribute [AllowAnonymous]

<PageTitle>Locked out</PageTitle>

<AuthFormCard Title="Locked out"
              Description="This account has been locked out. Please try again later."
              FooterPrompt="Return to "
              FooterLinkText="Log in"
              FooterHref="Account/Login">
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertDescription>This account has been locked out, please try again later.</BbAlertDescription>
    </BbAlert>
</AuthFormCard>
