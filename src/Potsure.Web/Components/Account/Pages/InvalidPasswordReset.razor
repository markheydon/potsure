@page "/Account/InvalidPasswordReset"
@attribute [AllowAnonymous]

<PageTitle>Invalid password reset</PageTitle>

<AuthFormCard Title="Invalid password reset"
              Description="This reset link is no longer valid."
              FooterPrompt="Request a new link from "
              FooterLinkText="Forgot password"
              FooterHref="Account/ForgotPassword">
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertDescription>The password reset link is invalid.</BbAlertDescription>
    </BbAlert>
</AuthFormCard>
