@page "/Account/ForgotPasswordConfirmation"
@attribute [AllowAnonymous]

<PageTitle>Forgot password confirmation</PageTitle>

<AuthFormCard Title="Check your email"
              Description="If an account exists for that address, we have sent a password reset link."
              FooterPrompt="Back to "
              FooterLinkText="Log in"
              FooterHref="Account/Login">
    <BbAlert Variant="AlertVariant.Default">
        <BbAlertDescription>Please check your email to reset your password.</BbAlertDescription>
    </BbAlert>
</AuthFormCard>
