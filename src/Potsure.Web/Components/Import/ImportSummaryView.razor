@using Potsure.Infrastructure.StatementImport

<BbCard>
    <BbCardHeader>
        <BbCardTitle>Import summary</BbCardTitle>
        <BbCardDescription>Upload @Summary.UploadId</BbCardDescription>
    </BbCardHeader>
    <BbCardContent>
        <BbItemGroup Class="grid gap-2 sm:grid-cols-2">
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>Imported</BbItemTitle>
                    <BbItemDescription>@Summary.ImportedCount</BbItemDescription>
                </BbItemContent>
            </BbItem>
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>Skipped</BbItemTitle>
                    <BbItemDescription>@Summary.SkippedCount</BbItemDescription>
                </BbItemContent>
            </BbItem>
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>Duplicates</BbItemTitle>
                    <BbItemDescription>@Summary.DedupedCount</BbItemDescription>
                </BbItemContent>
            </BbItem>
            <BbItem>
                <BbItemContent>
                    <BbItemTitle>Transfers excluded</BbItemTitle>
                    <BbItemDescription>@Summary.TransferExcludedCount</BbItemDescription>
                </BbItemContent>
            </BbItem>
        </BbItemGroup>

        @if (Summary.SkippedReasons.Count > 0)
        {
            <PotsurePageHeader Title="Skipped rows" HeadingLevel="2" Class="mb-4" />
            <BbItemGroup>
                @foreach (string reason in Summary.SkippedReasons)
                {
                    <BbItem>
                        <BbItemTitle>@reason</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        }
    </BbCardContent>
    <BbCardFooter>
        <BbTypographyMuted>
            Tip: importing about three months of Monzo history helps Potsure suggest recurring income and expenses more reliably. Shorter history is fine for getting started.
        </BbTypographyMuted>
        <BbButton Variant="ButtonVariant.Outline" OnClick="OnImportAnother">
            Import another file
        </BbButton>
    </BbCardFooter>
</BbCard>

@code {
    [Parameter, EditorRequired]
    public StatementImportSummary Summary { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnImportAnother { get; set; }
}
