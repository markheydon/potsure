<div class="bb:flex bb:flex-col bb:items-center bb:justify-center bb:gap-3 bb:py-8" role="status">
    <BbSpinner Size="SpinnerSize.Large" AriaLabel="@Message" />
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <BbTypographyMuted>@Message</BbTypographyMuted>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "Loading…";
}
