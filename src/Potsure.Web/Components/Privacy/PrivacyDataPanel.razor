@page "/privacy"
@rendermode InteractiveServer

<PageTitle>Export and delete data</PageTitle>

<PotsurePageHeader Title="Export and delete data"
                   Description="Export your financial data or permanently delete it. You will be asked to reauthenticate before either action completes."
                   HeadingLevel="1"
                   Class="mb-4" />

<section aria-label="Export">
    <PotsurePageHeader Title="Export" HeadingLevel="2" Class="mb-4" />
    <div class="grid gap-4 max-w-2xl">
        <div>
            <BbLabel>Format</BbLabel>
            <BbSelect TValue="ExportFormat" @bind-Value="_exportFormat">
                <BbSelectTrigger>
                    <BbSelectValue Placeholder="Select format" />
                </BbSelectTrigger>
                <BbSelectContent>
                    <BbSelectItem TValue="ExportFormat" Value="@ExportFormat.JsonBundle" Text="JSON bundle" />
                    <BbSelectItem TValue="ExportFormat" Value="@ExportFormat.CsvZip" Text="CSV ZIP" />
                </BbSelectContent>
            </BbSelect>
        </div>
    </div>
    <BbButton Disabled="_busy" OnClick="BeginExport">Export data</BbButton>
    @if (_showExportReauth)
    {
        <div class="rounded-lg border p-4 space-y-4" aria-label="Confirm export">
            <PotsurePageHeader Title="Confirm export" HeadingLevel="3" Class="mb-4" />
            @if (IsHosted)
            {
                <BbTypographyP>Enter your current account password to confirm export.</BbTypographyP>
                <BbInput Type="InputType.Password"
                         @bind-Value="_hostedPassword"
                         Autocomplete="current-password"
                         Placeholder="Current password" />
            }
            else
            {
                <BbTypographyP>Type @ExportPhrase to confirm you want to download your financial data.</BbTypographyP>
                <BbInput @bind-Value="_exportChallengePhrase" Placeholder="@ExportPhrase" />
            }
            <BbButton Disabled="_busy" OnClick="ConfirmExportReauthAsync">Continue export</BbButton>
        </div>
    }
    @if (_exportMessage is not null)
    {
        <BbTypographyP AdditionalAttributes="@(new Dictionary<string, object> { ["aria-live"] = "polite" })">@_exportMessage</BbTypographyP>
    }
    @if (_downloadBase64 is not null && _downloadFileName is not null)
    {
        <BbTypographyP>
            <BbLink Href="@($"data:{_downloadContentType};base64,{_downloadBase64}")"
                    AdditionalAttributes="@(new Dictionary<string, object> { ["download"] = _downloadFileName! })">
                Download @_downloadFileName
            </BbLink>
        </BbTypographyP>
    }
</section>

<section aria-label="Permanent deletion">
    <PotsurePageHeader Title="Permanent deletion" HeadingLevel="2" Class="mb-4" />
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Irreversible</BbAlertTitle>
        <BbAlertDescription>
            This removes all imported transactions, patterns, plan data, and pots for your account. It cannot be undone.
        </BbAlertDescription>
    </BbAlert>
    <BbCheckbox @bind-Checked="_confirmDelete">
        I understand this will permanently delete my financial data
    </BbCheckbox>
    <BbButton Variant="ButtonVariant.Destructive" Disabled="_busy || !_confirmDelete" OnClick="BeginDelete">
        Delete all financial data
    </BbButton>
    @if (_showDeleteReauth)
    {
        <div class="rounded-lg border p-4 space-y-4" aria-label="Confirm deletion">
            <PotsurePageHeader Title="Confirm deletion" HeadingLevel="3" Class="mb-4" />
            @if (IsHosted)
            {
                <BbTypographyP>Enter your current account password to confirm permanent deletion.</BbTypographyP>
                <BbInput Type="InputType.Password"
                         @bind-Value="_hostedPassword"
                         Autocomplete="current-password"
                         Placeholder="Current password" />
            }
            else
            {
                <BbTypographyP>Type @DeletePhrase to confirm permanent deletion.</BbTypographyP>
                <BbInput @bind-Value="_deleteChallengePhrase" Placeholder="@DeletePhrase" />
            }
            <BbButton Variant="ButtonVariant.Destructive" Disabled="_busy" OnClick="ConfirmDeleteReauthAsync">
                Continue deletion
            </BbButton>
        </div>
    }
    @if (_deleteMessage is not null)
    {
        <BbTypographyP AdditionalAttributes="@(new Dictionary<string, object> { ["aria-live"] = "polite" })">@_deleteMessage</BbTypographyP>
    }
</section>
