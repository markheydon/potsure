@page "/recurrence/review"
@rendermode InteractiveServer

<PageTitle>Recurring patterns</PageTitle>

<PotsurePageHeader Title="Review recurring patterns" HeadingLevel="1" Class="mb-4" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading suggestions…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Review unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else
{
    <BbTypographyMuted>
        Suggested patterns are inferred from imports. Confirm income and expenses separately before they affect commitments.
        For reliable automatic detection, we recommend at least three months of statement history; you can still review patterns with less history, but suggestions may be fewer or less certain.
    </BbTypographyMuted>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>@_statusMessage</BbAlertDescription>
        </BbAlert>
    }

    <section aria-label="Suggested">
        <PotsurePageHeader Title="Suggested" HeadingLevel="2" Class="mb-4" />
        @if (_suggested.Count == 0)
        {
            <BbTypographyP>No new suggestions. Import more history or open the recurring summary for confirmed patterns.</BbTypographyP>
        }
        else
        {
            <div class="flex flex-col gap-4">
                @foreach (RecurrenceReviewItem item in _suggested)
                {
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>@item.Label</BbCardTitle>
                            <BbCardDescription>
                                @(item.IsIncome ? "Income" : "Expense")
                                · @FormatCadence(item)
                                · typical £@item.TypicalAmount.ToString("F2")
                            </BbCardDescription>
                        </BbCardHeader>
                        <BbCardContent>
                        @if (item.IsIncome)
                        {
                            IncomeSplitInput splits = _incomeSplitsByLabel[item.Label];
                            <div>
                                <BbLabel>Cadence</BbLabel>
                                <BbSelect TValue="IncomeCadence" @bind-Value="_incomeCadenceByLabel[item.Label]">
                                    <BbSelectTrigger>
                                        <BbSelectValue Placeholder="Cadence" />
                                    </BbSelectTrigger>
                                    <BbSelectContent>
                                        @foreach (IncomeCadence cadence in Enum.GetValues<IncomeCadence>())
                                        {
                                            <BbSelectItem TValue="IncomeCadence" Value="@cadence" Text="@cadence.ToString()" />
                                        }
                                    </BbSelectContent>
                                </BbSelect>
                                <BbLabel>Needs %</BbLabel>
                                <BbInput Type="InputType.Number"
                                         Value="@FormatDecimal(splits.Needs)"
                                         ValueChanged="@(v => splits.Needs = ParseDecimal(v, splits.Needs))" />
                                <BbLabel>Wants %</BbLabel>
                                <BbInput Type="InputType.Number"
                                         Value="@FormatDecimal(splits.Wants)"
                                         ValueChanged="@(v => splits.Wants = ParseDecimal(v, splits.Wants))" />
                                <BbLabel>Savings &amp; debt %</BbLabel>
                                <BbInput Type="InputType.Number"
                                         Value="@FormatDecimal(splits.SavingsDebt)"
                                         ValueChanged="@(v => splits.SavingsDebt = ParseDecimal(v, splits.SavingsDebt))" />
                            </div>
                        }
                        else
                        {
                            <div>
                                <BbLabel>Category</BbLabel>
                                <BbSelect TValue="Guid" @bind-Value="_expenseCategoryByLabel[item.Label]">
                                    <BbSelectTrigger>
                                        <BbSelectValue Placeholder="Category" />
                                    </BbSelectTrigger>
                                    <BbSelectContent>
                                        @foreach (CategoryOption category in _categories)
                                        {
                                            <BbSelectItem TValue="Guid" Value="@category.Id" Text="@FormatCategoryKind(category.Kind)" />
                                        }
                                    </BbSelectContent>
                                </BbSelect>
                                <BbLabel>Mapped pot (optional)</BbLabel>
                                <BbSelect TValue="Guid"
                                          Value="@GetExpensePotSelection(item.Label)"
                                          ValueChanged="@(id => SetExpensePotSelection(item.Label, id))">
                                    <BbSelectTrigger>
                                        <BbSelectValue Placeholder="None" />
                                    </BbSelectTrigger>
                                    <BbSelectContent>
                                        <BbSelectItem TValue="Guid" Value="@Guid.Empty" Text="None" />
                                        @foreach (PotOption pot in PotsForCategory(_expenseCategoryByLabel[item.Label]))
                                        {
                                            <BbSelectItem TValue="Guid" Value="@pot.Id" Text="@pot.Name" />
                                        }
                                    </BbSelectContent>
                                </BbSelect>
                                <BbLabel>Tag (optional)</BbLabel>
                                <BbInput @bind-Value="_expenseTagByLabel[item.Label]" Placeholder="Display label" />
                            </div>
                        }
                        <div class="flex flex-wrap gap-2 mt-4">
                            <BbButton OnClick="() => ConfirmAsync(item)">Confirm</BbButton>
                            <BbButton Variant="ButtonVariant.Outline" OnClick="() => RejectAsync(item)">Reject</BbButton>
                        </div>
                        </BbCardContent>
                    </BbCard>
                }
            </div>
        }
    </section>

    <section aria-label="Confirmed or rejected">
        <PotsurePageHeader Title="Confirmed or rejected" HeadingLevel="2" Class="mb-4" />
        <div class="flex flex-col gap-4">
            @foreach (RecurrenceReviewItem item in _confirmedOrRejected)
            {
                <BbCard>
                    <BbCardContent>
                    <strong>@item.Label</strong>
                    — @item.State
                    (@FormatCadence(item))
                    @if (!item.IsIncome && item.State == PatternConfirmationState.Confirmed)
                    {
                        <BbCheckbox Checked="@_mergeSelection.Contains(item.Label)"
                                    CheckedChanged="@(selected => SetMergeIncluded(item.Label, selected))">
                            Include in merge
                        </BbCheckbox>
                    }
                    </BbCardContent>
                </BbCard>
            }
        </div>
    </section>

    <section aria-label="Merge expense patterns">
        <PotsurePageHeader Title="Merge expense patterns" HeadingLevel="2" Class="mb-4" />
        <BbTypographyMuted>Select confirmed expenses above, then merge into one pattern.</BbTypographyMuted>
        @if (_mergeRequiresExplicitResolution)
        {
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertDescription>
                    Selected patterns disagree on category, pot, or tag. Choose one assignment for the merged pattern.
                </BbAlertDescription>
            </BbAlert>
        }
        <BbInput @bind-Value="_mergeLabel" Placeholder="Merged vendor label (optional)" />
        <BbLabel>Category</BbLabel>
        <BbSelect TValue="Guid" @bind-Value="_mergeCategoryId">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="Category" />
            </BbSelectTrigger>
            <BbSelectContent>
                @foreach (CategoryOption category in _categories)
                {
                    <BbSelectItem TValue="Guid" Value="@category.Id" Text="@FormatCategoryKind(category.Kind)" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbLabel>Mapped pot (optional)</BbLabel>
        <BbSelect TValue="Guid" @bind-Value="MergePotSelection">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="None" />
            </BbSelectTrigger>
            <BbSelectContent>
                <BbSelectItem TValue="Guid" Value="@Guid.Empty" Text="None" />
                @foreach (PotOption pot in PotsForCategory(_mergeCategoryId))
                {
                    <BbSelectItem TValue="Guid" Value="@pot.Id" Text="@pot.Name" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbLabel>Tag (optional)</BbLabel>
        <BbInput @bind-Value="_mergeTag" Placeholder="Display label" />
        <BbButton OnClick="MergeSelectedAsync">Merge selected</BbButton>
    </section>

    <section aria-label="Split expense pattern">
        <PotsurePageHeader Title="Split expense pattern" HeadingLevel="2" Class="mb-4" />
        <BbLabel>Source pattern</BbLabel>
        <BbSelect TValue="string" @bind-Value="SplitSourceSelection">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="Select…" />
            </BbSelectTrigger>
            <BbSelectContent>
                @foreach (RecurrenceReviewItem item in _confirmedOrRejected.Where(i => !i.IsIncome && i.State == PatternConfirmationState.Confirmed))
                {
                    <BbSelectItem TValue="string" Value="@item.Label" Text="@item.Label" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbInput @bind-Value="_splitPartOneLabel" Placeholder="First part label" />
        <BbSelect TValue="Guid" @bind-Value="_splitPartOneCategoryId">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="First part category" />
            </BbSelectTrigger>
            <BbSelectContent>
                @foreach (CategoryOption category in _categories)
                {
                    <BbSelectItem TValue="Guid" Value="@category.Id" Text="@FormatCategoryKind(category.Kind)" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbSelect TValue="Guid" @bind-Value="SplitPartOnePotSelection">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="First part pot" />
            </BbSelectTrigger>
            <BbSelectContent>
                <BbSelectItem TValue="Guid" Value="@Guid.Empty" Text="None" />
                @foreach (PotOption pot in PotsForCategory(_splitPartOneCategoryId))
                {
                    <BbSelectItem TValue="Guid" Value="@pot.Id" Text="@pot.Name" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbInput @bind-Value="_splitPartOneTag" Placeholder="First part tag (optional)" />
        <BbInput @bind-Value="_splitPartTwoLabel" Placeholder="Second part label" />
        <BbSelect TValue="Guid" @bind-Value="_splitPartTwoCategoryId">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="Second part category" />
            </BbSelectTrigger>
            <BbSelectContent>
                @foreach (CategoryOption category in _categories)
                {
                    <BbSelectItem TValue="Guid" Value="@category.Id" Text="@FormatCategoryKind(category.Kind)" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbSelect TValue="Guid" @bind-Value="SplitPartTwoPotSelection">
            <BbSelectTrigger>
                <BbSelectValue Placeholder="Second part pot" />
            </BbSelectTrigger>
            <BbSelectContent>
                <BbSelectItem TValue="Guid" Value="@Guid.Empty" Text="None" />
                @foreach (PotOption pot in PotsForCategory(_splitPartTwoCategoryId))
                {
                    <BbSelectItem TValue="Guid" Value="@pot.Id" Text="@pot.Name" />
                }
            </BbSelectContent>
        </BbSelect>
        <BbInput @bind-Value="_splitPartTwoTag" Placeholder="Second part tag (optional)" />
        <BbButton OnClick="SplitPatternAsync">Split pattern</BbButton>
    </section>

    <PotsureRelatedNav>
        <BbLink Href="/recurrence/summary">Open recurring summary</BbLink>
    </PotsureRelatedNav>
}
