@page "/recurrence/review"
@rendermode InteractiveServer

<PageTitle>Recurring patterns</PageTitle>

<h1 id="recurrence-review-heading">Review recurring patterns</h1>

@if (_loading)
{
    <p>Loading suggestions…</p>
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Review unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else
{
    <p class="potsure-muted">
        Suggested patterns are inferred from imports. Confirm income and expenses separately before they affect commitments.
        For reliable automatic detection, we recommend at least three months of statement history; you can still review patterns with less history, but suggestions may be fewer or less certain.
    </p>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>@_statusMessage</BbAlertDescription>
        </BbAlert>
    }

    <section aria-labelledby="recurrence-suggested">
        <h2 id="recurrence-suggested">Suggested</h2>
        @if (_suggested.Count == 0)
        {
            <p>No new suggestions. Import more history or open the recurring summary for confirmed patterns.</p>
        }
        else
        {
            <ul class="potsure-review-list" role="list">
                @foreach (RecurrenceReviewItem item in _suggested)
                {
                    <li class="potsure-review-item">
                        <strong>@item.Label</strong>
                        — @(item.IsIncome ? "Income" : "Expense")
                        (@FormatCadence(item))
                        typical £@item.TypicalAmount.ToString("F2")
                        @if (item.IsIncome)
                        {
                            IncomeSplitInput splits = _incomeSplitsByLabel[item.Label];
                            <div>
                                <label>
                                    Cadence
                                    <InputSelect @bind-Value="_incomeCadenceByLabel[item.Label]">
                                        @foreach (IncomeCadence cadence in Enum.GetValues<IncomeCadence>())
                                        {
                                            <option value="@cadence">@cadence</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label>Needs % <InputNumber @bind-Value="splits.Needs" /></label>
                                <label>Wants % <InputNumber @bind-Value="splits.Wants" /></label>
                                <label>Savings &amp; debt % <InputNumber @bind-Value="splits.SavingsDebt" /></label>
                            </div>
                        }
                        else
                        {
                            <div>
                                <label>
                                    Category
                                    <InputSelect @bind-Value="_expenseCategoryByLabel[item.Label]">
                                        @foreach (CategoryOption category in _categories)
                                        {
                                            <option value="@category.Id">@FormatCategoryKind(category.Kind)</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label>
                                    Mapped pot (optional)
                                    <InputSelect @bind-Value="_expensePotByLabel[item.Label]">
                                        <option value="">None</option>
                                        @foreach (PotOption pot in PotsForCategory(_expenseCategoryByLabel[item.Label]))
                                        {
                                            <option value="@pot.Id">@pot.Name</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label>
                                    Tag (optional)
                                    <BbInput @bind-Value="_expenseTagByLabel[item.Label]" Placeholder="Display label" />
                                </label>
                            </div>
                        }
                        <BbButton OnClick="() => ConfirmAsync(item)">Confirm</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" OnClick="() => RejectAsync(item)">Reject</BbButton>
                    </li>
                }
            </ul>
        }
    </section>

    <section aria-labelledby="recurrence-confirmed">
        <h2 id="recurrence-confirmed">Confirmed or rejected</h2>
        <ul class="potsure-review-list" role="list">
            @foreach (RecurrenceReviewItem item in _confirmedOrRejected)
            {
                <li>
                    <strong>@item.Label</strong>
                    — @item.State
                    (@FormatCadence(item))
                    @if (!item.IsIncome && item.State == PatternConfirmationState.Confirmed)
                    {
                        <label>
                            <input type="checkbox"
                                   checked="@_mergeSelection.Contains(item.Label)"
                                   @onchange="() => ToggleMergeSelection(item.Label)" />
                            Include in merge
                        </label>
                    }
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="recurrence-merge">
        <h2 id="recurrence-merge">Merge expense patterns</h2>
        <p class="potsure-muted">Select confirmed expenses above, then merge into one pattern.</p>
        @if (_mergeRequiresExplicitResolution)
        {
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertDescription>
                    Selected patterns disagree on category, pot, or tag. Choose one assignment for the merged pattern.
                </BbAlertDescription>
            </BbAlert>
        }
        <BbInput @bind-Value="_mergeLabel" Placeholder="Merged vendor label (optional)" />
        <label>
            Category
            <InputSelect @bind-Value="_mergeCategoryId">
                @foreach (CategoryOption category in _categories)
                {
                    <option value="@category.Id">@FormatCategoryKind(category.Kind)</option>
                }
            </InputSelect>
        </label>
        <label>
            Mapped pot (optional)
            <InputSelect @bind-Value="_mergePotId">
                <option value="">None</option>
                @foreach (PotOption pot in PotsForCategory(_mergeCategoryId))
                {
                    <option value="@pot.Id">@pot.Name</option>
                }
            </InputSelect>
        </label>
        <label>
            Tag (optional)
            <BbInput @bind-Value="_mergeTag" Placeholder="Display label" />
        </label>
        <BbButton OnClick="MergeSelectedAsync">Merge selected</BbButton>
    </section>

    <section aria-labelledby="recurrence-split">
        <h2 id="recurrence-split">Split expense pattern</h2>
        <label>
            Source pattern
            <InputSelect @bind-Value="_splitSourceLabel">
                <option value="">Select…</option>
                @foreach (RecurrenceReviewItem item in _confirmedOrRejected.Where(i => !i.IsIncome && i.State == PatternConfirmationState.Confirmed))
                {
                    <option value="@item.Label">@item.Label</option>
                }
            </InputSelect>
        </label>
        <BbInput @bind-Value="_splitPartOneLabel" Placeholder="First part label" />
        <InputSelect @bind-Value="_splitPartOneCategoryId">
            @foreach (CategoryOption category in _categories)
            {
                <option value="@category.Id">@FormatCategoryKind(category.Kind)</option>
            }
        </InputSelect>
        <InputSelect @bind-Value="_splitPartOnePotId">
            <option value="">None</option>
            @foreach (PotOption pot in PotsForCategory(_splitPartOneCategoryId))
            {
                <option value="@pot.Id">@pot.Name</option>
            }
        </InputSelect>
        <BbInput @bind-Value="_splitPartOneTag" Placeholder="First part tag (optional)" />
        <BbInput @bind-Value="_splitPartTwoLabel" Placeholder="Second part label" />
        <InputSelect @bind-Value="_splitPartTwoCategoryId">
            @foreach (CategoryOption category in _categories)
            {
                <option value="@category.Id">@FormatCategoryKind(category.Kind)</option>
            }
        </InputSelect>
        <InputSelect @bind-Value="_splitPartTwoPotId">
            <option value="">None</option>
            @foreach (PotOption pot in PotsForCategory(_splitPartTwoCategoryId))
            {
                <option value="@pot.Id">@pot.Name</option>
            }
        </InputSelect>
        <BbInput @bind-Value="_splitPartTwoTag" Placeholder="Second part tag (optional)" />
        <BbButton OnClick="SplitPatternAsync">Split pattern</BbButton>
    </section>

    <nav aria-label="Related">
        <a href="/recurrence/summary">Open recurring summary</a>
    </nav>
}
