@page "/recurrence/summary"
@rendermode InteractiveServer

<PageTitle>Recurring summary</PageTitle>

<h1 id="recurring-summary-heading">Confirmed recurring summary</h1>

@if (_loading)
{
    <p>Loading summary…</p>
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Summary unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_model is not null)
{
    <section aria-labelledby="summary-income">
        <h2 id="summary-income">Confirmed income</h2>
        @if (_model.ConfirmedIncome.Count == 0)
        {
            <p>No confirmed income patterns yet.</p>
        }
        else
        {
            <BbDataTable TData="ConfirmedIncomeSummaryRow"
                           Data="@_model.ConfirmedIncome"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Income patterns used for display splits only">
                <Columns>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Source"
                                       Property="@(row => row.SourceLabel)" />
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Cadence">
                        <CellTemplate Context="row">
                            @row.Cadence
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="decimal"
                                       Header="Amount">
                        <CellTemplate Context="row">
                            £@((row.FixedAmount ?? row.EstimateAmount ?? 0m).ToString("F2"))
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedIncomeSummaryRow" TValue="string"
                                       Header="Splits (Needs / Wants / Savings)">
                        <CellTemplate Context="row">
                            @row.SplitNeedsPercent% / @row.SplitWantsPercent% / @row.SplitSavingsDebtPercent%
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        }
    </section>

    <section aria-labelledby="summary-expenses">
        <h2 id="summary-expenses">Confirmed expenses</h2>
        @if (_model.ConfirmedExpenses.Count == 0)
        {
            <p>No confirmed expense patterns yet.</p>
        }
        else
        {
            <BbDataTable TData="ConfirmedExpenseSummaryRow"
                           Data="@_model.ConfirmedExpenses"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Expense commitments for budget balance">
                <Columns>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Vendor"
                                       Property="@(row => row.VendorLabel)" />
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Category">
                        <CellTemplate Context="row">
                            @row.CategoryKind
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Cadence">
                        <CellTemplate Context="row">
                            @row.Cadence
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="decimal"
                                       Header="Amount">
                        <CellTemplate Context="row">
                            £@((row.FixedAmount ?? row.MonthlyEstimate ?? 0m).ToString("F2"))
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Coverage"
                                       Property="@(row => row.EstimateCoverageLabel ?? "—")" />
                    <BbDataTableColumn TData="ConfirmedExpenseSummaryRow" TValue="string"
                                       Header="Tag"
                                       Property="@(row => row.Tag ?? "—")" />
                </Columns>
            </BbDataTable>
        }
    </section>

    <section aria-labelledby="summary-suggestions">
        <h2 id="summary-suggestions">Suggestions (not confirmed)</h2>
        @if (_model.Suggestions.Count == 0)
        {
            <p>No open suggestions.</p>
        }
        else
        {
            <ul role="list">
                @foreach (SuggestedPatternSummaryRow row in _model.Suggestions)
                {
                    <li>@row.Label — @(row.IsIncome ? "Income" : "Expense"), @row.CadenceDescription, ~£@row.TypicalAmount.ToString("F2")</li>
                }
            </ul>
            <p><a href="/recurrence/review">Review suggestions</a></p>
        }
    </section>
}
