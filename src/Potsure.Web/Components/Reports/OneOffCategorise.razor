@page "/reports/categorise"
@rendermode InteractiveServer

<PageTitle>Assign transactions</PageTitle>

<h1 id="categorise-heading">Assign transactions</h1>

<p class="potsure-muted">
    One-off assignments affect category actual activity only and do not create recurring patterns (FR-M037).
</p>

@if (_loading)
{
    <p>Loading transactions…</p>
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_transactions.Count == 0)
{
    <p>No unattributed transactions in the current budget period.</p>
    <nav aria-label="Related">
        <a href="/reports/category-health">Back to category health</a>
    </nav>
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>@_statusMessage</BbAlertDescription>
        </BbAlert>
    }

    <BbDataTable TData="UncategorisedTransactionRow"
                 Data="@_transactions"
                 ShowToolbar="false"
                 ShowPagination="false"
                 AriaLabel="Unattributed transactions">
        <Columns>
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="DateOnly"
                               Header="Date">
                <CellTemplate Context="row">
                    @row.TransactionDate.ToString("dd/MM/yyyy")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="string"
                               Header="Name"
                               Property="@(row => row.Name)" />
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="TransactionKind"
                               Header="Kind">
                <CellTemplate Context="row">
                    @FormatKind(row.Kind)
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="decimal"
                               Header="Amount">
                <CellTemplate Context="row">
                    £@Math.Abs(row.Amount).ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="Guid"
                               Header="Category">
                <CellTemplate Context="row">
                    <BbSelect TValue="Guid" @bind-Value="_selectedCategoryByTransaction[row.TransactionId]">
                        <BbSelectTrigger>
                            <BbSelectValue Placeholder="Category" />
                        </BbSelectTrigger>
                        <BbSelectContent>
                            @foreach (CategoryOption category in _categories)
                            {
                                <BbSelectItem TValue="Guid" Value="@category.Id" Text="@FormatCategoryKind(category.Kind)" />
                            }
                        </BbSelectContent>
                    </BbSelect>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="UncategorisedTransactionRow" TValue="string"
                               Header="Actions">
                <CellTemplate Context="row">
                    <BbButton OnClick="() => AssignAsync(row.TransactionId)">Assign</BbButton>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    <nav aria-label="Related">
        <a href="/reports/category-health">Back to category health</a>
    </nav>
}
