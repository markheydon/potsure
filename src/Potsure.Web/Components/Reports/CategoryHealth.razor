@page "/reports/category-health"
@rendermode InteractiveServer

<PageTitle>Category health</PageTitle>

<h1>Category health</h1>

@if (_loading)
{
    <p>Loading report…</p>
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Report unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else if (_summary is not null)
{
    <section class="potsure-income-summary" aria-labelledby="category-health-income">
        <h2 id="category-health-income">Income</h2>
        <dl>
            <div>
                <dt>@ReportCopy.BudgetedIncomeHeading</dt>
                <dd>£@_summary.Value.BudgetedIncome.Amount.ToString("F2")</dd>
            </div>
            <div>
                <dt>@ReportCopy.ActualReceiptsHeading</dt>
                <dd>£@_summary.Value.ActualIncomeInPeriod.Amount.ToString("F2")</dd>
            </div>
        </dl>
        <p class="potsure-report-note">@ReportCopy.CategoryHealthBudgetedNote</p>
    </section>

    @if (_categoryChartRows.Count > 0)
    {
        <section aria-labelledby="category-health-chart-heading">
            <h2 id="category-health-chart-heading" class="potsure-sr-only">Category measures chart</h2>
            <BbBarChart Data="@_categoryChartRows"
                        Config="@_categoryChartConfig"
                        Title="Category measures"
                        Height="350px"
                        AriaLabel="Grouped bar chart of allocation, recorded funding and actual activity by category">
                <BbXAxis DataKey="Category" />
                <BbYAxis />
                <BbChartTooltip />
                <BbChartLegend />
                <BbBar DataKey="Allocation" />
                <BbBar DataKey="RecordedFunding" />
                <BbBar DataKey="Actual" />
            </BbBarChart>
        </section>
    }

    <BbDataTable TData="CategoryPeriodTableRow"
                 Data="@_categoryTableRows"
                 ShowToolbar="false"
                 ShowPagination="false"
                 AriaLabel="@CategoryTableAriaLabel">
        <Columns>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="BudgetCategoryKind"
                               Header="Category">
                <CellTemplate Context="row">
                    @FormatKind(row.Summary.Kind)
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Allocation">
                <CellTemplate Context="row">
                    £@row.Summary.Allocation.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Recorded funding">
                <CellTemplate Context="row">
                    £@row.Summary.RecordedFunding.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Actual activity">
                <CellTemplate Context="row">
                    £@row.Summary.ActualActivity.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="CategoryPeriodTableRow" TValue="decimal"
                               Header="Under / over">
                <CellTemplate Context="row">
                    £@row.Summary.UnderOver.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    @foreach (CategoryPeriodSummary row in _summary.Value.Categories.Where(c => c.OverAllocationWarning))
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Over-allocation</BbAlertTitle>
            <BbAlertDescription>
                Recorded funding and pot assignments exceed allocation for @FormatKind(row.Kind).
            </BbAlertDescription>
        </BbAlert>
    }

    @if (_potBreakdown.Count > 0)
    {
        <section aria-labelledby="category-health-pots">
            <h2 id="category-health-pots">Mapped bank pots</h2>
            <BbDataTable TData="CategoryPotBreakdownLine"
                           Data="@_potBreakdown"
                           ShowToolbar="false"
                           ShowPagination="false"
                           AriaLabel="Pot funding by category">
                <Columns>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="BudgetCategoryKind"
                                       Header="Category">
                        <CellTemplate Context="pot">
                            @FormatKind(pot.Category)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="string"
                                       Header="Pot"
                                       Property="@(pot => pot.PotName)" />
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="string"
                                       Header="Allocation to pot">
                        <CellTemplate Context="pot">
                            @(pot.AllocationToPot is decimal allocation ? $"£{allocation:F2}" : "—")
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CategoryPotBreakdownLine" TValue="decimal"
                                       Header="Recorded funding">
                        <CellTemplate Context="pot">
                            £@pot.RecordedFunding.ToString("F2")
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
            </BbDataTable>
        </section>
    }

    <p class="potsure-sr-table-summary" id="category-health-text-summary">
        Textual summary:
        @foreach (CategoryPeriodSummary row in _summary.Value.Categories)
        {
            <span>@FormatKind(row.Kind): allocation £@row.Allocation.Amount.ToString("F2"), recorded funding £@row.RecordedFunding.Amount.ToString("F2"), actual £@row.ActualActivity.Amount.ToString("F2"), under/over £@row.UnderOver.Amount.ToString("F2"). </span>
        }
    </p>

    @if (_summary.Value.UncategorisedSpendWarning)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Uncategorised spend</BbAlertTitle>
            <BbAlertDescription>
                £@_summary.Value.UncategorisedSpend.Amount.ToString("F2") of spend is not attributed to a category.
                <a href="/reports/categorise">Assign transactions</a>
                · <a href="/reports/attribution">Reassign attributed debits</a>
            </BbAlertDescription>
        </BbAlert>
    }
}
