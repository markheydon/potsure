@page "/reports/runway"
@rendermode InteractiveServer

<PageTitle>Runway warnings</PageTitle>

<PotsurePageHeader Title="Category runway" HeadingLevel="1" Class="mb-4" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading runway…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Runway unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else
{
    <section aria-labelledby="runway-horizon">
        <PotsurePageHeader Title="Forecast horizon" HeadingLevel="2" Class="mb-4" />
        <BbLabel>Months ahead</BbLabel>
        <BbInput Type="InputType.Number"
                 Value="@_horizonMonths.ToString()"
                 ValueChanged="@(v => _horizonMonths = ParseHorizonMonths(v, _horizonMonths))"
                 AdditionalAttributes="@(HorizonInputAttributes)" />
        <BbButton Variant="ButtonVariant.Default" OnClick="SaveHorizonAsync">Update horizon</BbButton>
    </section>

    @if (_flags.Messages.Count > 0)
    {
        <BbAlert Variant="AlertVariant.Warning">
            <BbAlertTitle>Forecast uncertainty</BbAlertTitle>
            <BbAlertDescription>
                <BbItemGroup>
                    @foreach (string message in _flags.Messages)
                    {
                        <BbItem>
                            <BbItemTitle>@message</BbItemTitle>
                        </BbItem>
                    }
                </BbItemGroup>
            </BbAlertDescription>
        </BbAlert>
    }

    <section aria-labelledby="runway-income-measures">
        <PotsurePageHeader Title="Income (separate from commitments)" HeadingLevel="2" Class="mb-4" />
        <BbTypographyMuted>
            @ReportCopy.BudgetedIncomeHeading and @ReportCopy.ActualReceiptsHeading are not mixed with projected spend below.
        </BbTypographyMuted>
    </section>

    <BbDataTable TData="RunwayTableRow"
                 Data="@_runwayTableRows"
                 ShowToolbar="false"
                 ShowPagination="false"
                 AriaLabel="Runway by category">
        <Columns>
            <BbDataTableColumn TData="RunwayTableRow" TValue="string"
                               Header="Category">
                <CellTemplate Context="row">
                    @FormatKind(row.Line.Category)
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunwayTableRow" TValue="decimal"
                               Header="Projected spend">
                <CellTemplate Context="row">
                    £@row.Line.ProjectedRemainingSpend.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunwayTableRow" TValue="decimal"
                               Header="Threshold">
                <CellTemplate Context="row">
                    £@row.Line.Threshold.Amount.ToString("F2")
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="RunwayTableRow" TValue="bool"
                               Header="Shortfall">
                <CellTemplate Context="row">
                    @(row.Line.IsShortfall ? "Yes" : "No")
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    @if (_variableExpenses.Count > 0)
    {
        <section aria-labelledby="runway-variable">
            <PotsurePageHeader Title="Variable expense coverage" HeadingLevel="2" Class="mb-4" />
            <BbItemGroup>
                @foreach (ConfirmedExpenseSummaryRow expense in _variableExpenses)
                {
                    <BbItem>
                        <BbItemTitle>@expense.VendorLabel: @(expense.EstimateCoverageLabel ?? "Estimate pending")</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        </section>
    }

    @if (_potBreakdown.Count > 0)
    {
        <section aria-labelledby="runway-pots">
            <PotsurePageHeader Title="Mapped pots (funding context)" HeadingLevel="2" Class="mb-4" />
            <BbItemGroup>
                @foreach (CategoryPotBreakdownLine pot in _potBreakdown)
                {
                    <BbItem>
                        <BbItemTitle>@pot.Category — @pot.PotName: £@pot.RecordedFunding.ToString("F2") recorded</BbItemTitle>
                    </BbItem>
                }
            </BbItemGroup>
        </section>
    }

    <div class="mt-4" id="runway-text-summary">
        <BbTypographyMuted>Textual summary:</BbTypographyMuted>
        <BbItemGroup>
            @foreach (RunwayProjectionLine line in _lines)
            {
                <BbItem>
                    <BbItemTitle>@line.Category projected £@line.ProjectedRemainingSpend.Amount.ToString("F2") against threshold £@line.Threshold.Amount.ToString("F2").</BbItemTitle>
                </BbItem>
            }
        </BbItemGroup>
    </div>
}
