@page "/plan/funding"
@rendermode InteractiveServer

<PageTitle>Recorded funding</PageTitle>

<h1 id="funding-heading">Recorded and planned funding</h1>

@if (_loading)
{
    <p>Loading funding…</p>
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Funding unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else
{
    <p class="potsure-report-note">
        Four measures on reports: allocation, recorded funding, actual activity, and under/over.
        Recorded funding is what you have already set aside; imports do not change it.
    </p>

    @foreach (FundingFormRow row in _rows)
    {
        <section class="potsure-funding-row" aria-labelledby="@($"funding-{row.CategoryId}")">
            <h2 id="@($"funding-{row.CategoryId}")">@row.Kind</h2>
            <div class="potsure-form-grid">
                <label>
                    Recorded funding (category)
                    <InputNumber @bind-Value="row.RecordedDirect" />
                </label>
                <label>
                    Planned future funding (category)
                    <InputNumber @bind-Value="row.PlannedDirect" />
                </label>
            </div>
            @if (row.Pots.Count > 0)
            {
                <h3>Pot recorded funding</h3>
                <ul role="list">
                    @foreach (PotFundingForm pot in row.Pots)
                    {
                        <li>
                            <label>
                                @pot.Name
                                <InputNumber @bind-Value="pot.Recorded" />
                            </label>
                        </li>
                    }
                </ul>
            }
            <BbButton Variant="ButtonVariant.Default" OnClick="() => SaveRowAsync(row)">Save @row.Kind</BbButton>
        </section>
    }
}
