@page "/plan/funding"
@rendermode InteractiveServer

<PageTitle>Recorded funding</PageTitle>

<PotsurePageHeader Title="Recorded and planned funding" HeadingLevel="1" Class="mb-4" />

@if (_loading)
{
    <PotsureLoadingState Message="Loading funding…" />
}
else if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Warning">
        <BbAlertTitle>Funding unavailable</BbAlertTitle>
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
}
else
{
    <BbTypographyMuted>
        Four measures on reports: allocation, recorded funding, actual activity, and under/over.
        Recorded funding is what you have already set aside; imports do not change it.
    </BbTypographyMuted>

    @foreach (FundingFormRow row in _rows)
    {
        <section class="space-y-4 mb-6" aria-label="@row.Kind.ToString()">
            <PotsurePageHeader Title="@row.Kind.ToString()" HeadingLevel="2" Class="mb-4" />
            <div class="grid gap-4 max-w-2xl">
                <div>
                    <BbLabel>Recorded funding (category)</BbLabel>
                    <BbInput Type="InputType.Number"
                             Value="@FormatDecimal(row.RecordedDirect)"
                             ValueChanged="@(v => row.RecordedDirect = ParseDecimal(v, row.RecordedDirect))" />
                </div>
                <div>
                    <BbLabel>Planned future funding (category)</BbLabel>
                    <BbInput Type="InputType.Number"
                             Value="@FormatDecimal(row.PlannedDirect)"
                             ValueChanged="@(v => row.PlannedDirect = ParseDecimal(v, row.PlannedDirect))" />
                </div>
            </div>
            @if (row.Pots.Count > 0)
            {
                <PotsurePageHeader Title="Pot recorded funding" HeadingLevel="3" Class="mb-4" />
                <BbItemGroup Class="grid gap-4 max-w-2xl">
                    @foreach (PotFundingForm pot in row.Pots)
                    {
                        <BbItem>
                            <BbItemContent Class="grid gap-1.5">
                                <BbLabel>@pot.Name</BbLabel>
                                <BbInput Type="InputType.Number"
                                         Value="@FormatDecimal(pot.Recorded)"
                                         ValueChanged="@(v => pot.Recorded = ParseDecimal(v, pot.Recorded))" />
                            </BbItemContent>
                        </BbItem>
                    }
                </BbItemGroup>
            }
            <BbButton Variant="ButtonVariant.Default" OnClick="() => SaveRowAsync(row)">Save @row.Kind</BbButton>
        </section>
    }
}
