@using Potsure.Web.Components
@using Potsure.Web.Components.Account

<Router AppAssembly="@typeof(Program).Assembly" NotFoundPage="typeof(Potsure.Web.Components.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>You are not authorised to access this resource.</BbAlertDescription>
                    </BbAlert>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
