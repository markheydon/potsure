<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- .NET Aspire: AppHost resources and client integrations -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
  </ItemGroup>

  <!-- BlazorBlueprint UI -->
  <ItemGroup>
    <PackageVersion Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageVersion Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
  </ItemGroup>

  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

  <!-- Microsoft.Extensions (resilience, service discovery) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>

  <!-- OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
  </ItemGroup>

  <!-- Azure SDK -->
  <ItemGroup>
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>

  <!-- Application libraries -->
  <ItemGroup>
    <PackageVersion Include="CsvHelper" Version="34.1.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
