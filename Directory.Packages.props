<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- .NET Aspire: AppHost resources and client integrations -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Hosting.EntityFrameworkCore" Version="13.6.4-preview.1.26523.11" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.4" />
  </ItemGroup>

  <!-- BlazorBlueprint UI -->
  <ItemGroup>
    <PackageVersion Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageVersion Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
  </ItemGroup>

  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <!-- Entity Framework Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
  </ItemGroup>

  <!-- Microsoft.Extensions (resilience, service discovery) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>

  <!-- OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <!-- Application libraries -->
  <ItemGroup>
    <PackageVersion Include="CsvHelper" Version="34.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
